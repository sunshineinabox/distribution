# Clean the packages of the last build that were built against a dependency
# which has since changed what it installs, or that link a library the image no
# longer has, so the next build rebuilds them. Prints the cleaned packages.

. config/options ""

[ "${CLEAN_DEPENDENTS}" = "no" ] && exit 0
[ -f "${THREAD_CONTROL}/plan.json" ] || exit 0

# no toolchain yet, nothing to compare against
compiler="$("${TARGET_PREFIX}gcc" -dumpfullversion 2>/dev/null)"
[ -n "${compiler}" ] || exit 0

case "${TARGET_ARCH}" in
  aarch64) machine=183 ;;
  arm) machine=40 ;;
  x86_64) machine=62 ;;
  *) machine=0 ;;
esac

for pkg in $(${SCRIPTS}/clean_dependents.py \
  --plan "${THREAD_CONTROL}/plan.json" \
  --build "${BUILD}" \
  --stamps "${STAMPS}" \
  --readelf "$(command -v "${TARGET_PREFIX}readelf" || echo readelf)" \
  --machine "${machine}" \
  --compiler "${compiler}"); do
  ${SCRIPTS}/clean "${pkg}" >&2
  echo "${pkg}"
done
