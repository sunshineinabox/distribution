#!/usr/bin/env bash
for var in $(compgen -e); do
  [[ "$var" == PATH  ]] && continue
  # a host TMPDIR (macOS sets one) does not exist inside the container
  [[ "$var" == TMPDIR ]] && continue
  # underscore variables are derived build state, recomputed only when unset
  [[ "$var" == _* ]] && continue
  echo "$var=${!var}"
done
