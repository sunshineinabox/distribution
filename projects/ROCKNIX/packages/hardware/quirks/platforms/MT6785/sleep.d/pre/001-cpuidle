# s2idle never resumes with cores parked in cpu-off, so idle in WFI instead
for STATE in /sys/devices/system/cpu/cpu*/cpuidle/state*; do
  [ "$(cat ${STATE}/name)" = "cpu-off" ] && echo 1 >${STATE}/disable
done
