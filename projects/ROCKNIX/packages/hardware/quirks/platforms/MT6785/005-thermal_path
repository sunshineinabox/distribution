# thermal_zone0 = cpu-big0, thermal_zone5 = gpu0 (DT order)
cat <<EOF >/storage/.config/profile.d/005-thermal_path
DEVICE_TEMP_SENSOR=("/sys/devices/virtual/thermal/thermal_zone0/temp")
DEVICE_GPU_TEMP_SENSOR=("/sys/devices/virtual/thermal/thermal_zone5/temp")
EOF
