### Set the default device configuration
cat <<'EOF' >/storage/.config/profile.d/090-ui_service
UI_SERVICE="sway.service essway.service"
PAN_I_WANT_A_BROKEN_VULKAN_DRIVER=1
DISABLE_WSI_LAYER=1
# gpu.driver=libmali loads the stock Mali blob through libhybris
if [ -e /run/hybris-mali/active ]; then
  . /usr/lib/hybris-mali/env
fi
EOF
