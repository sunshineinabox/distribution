# No WiFi yet: start in USB network mode so the device is reachable over SSH.
# Runs before the common 081-usbgadget and keeps any mode set since.
CONF=/storage/.cache/usbgadget/usbgadget.conf

if [ ! -s "${CONF}" ]; then
  mkdir -p "$(dirname "${CONF}")"
  echo "USB_MODE=cdc" >"${CONF}"
fi
