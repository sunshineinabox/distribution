# Default to USB networking for SSH access, ahead of the common 081-usbgadget
CONF=/storage/.cache/usbgadget/usbgadget.conf

if [ ! -s "${CONF}" ]; then
  mkdir -p "$(dirname "${CONF}")"
  echo "USB_MODE=cdc" >"${CONF}"
fi
