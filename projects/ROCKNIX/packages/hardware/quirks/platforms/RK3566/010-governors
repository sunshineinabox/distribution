. /etc/profile.d/001-functions

cat <<EOF >/storage/.config/profile.d/010-governors
# FREQ governors
CPU_FREQ=("/sys/devices/system/cpu/cpufreq/policy0")
GPU_FREQ=("/sys/devices/platform/fde60000.gpu/devfreq/fde60000.gpu")
EOF

# ondemand keeps downclocking the two-thread emulator pipeline
if [ -z "$(get_setting system.cpugovernor)" ]; then
  set_setting system.cpugovernor schedutil
fi
