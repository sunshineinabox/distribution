# Disable cpu0 rail power collapse, seems to cause GMU issues.
# Match on the state name rather than the index.
for state in /sys/devices/system/cpu/cpu0/cpuidle/state*; do
  case "$(cat "${state}/desc" 2>/dev/null)" in
    *rail-power-collapse*) echo 1 > "${state}/disable" ;;
  esac
done
