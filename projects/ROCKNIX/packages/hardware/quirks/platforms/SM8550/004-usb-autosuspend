# An active DWC3 keeps its USB-to-DDR interconnect vote and blocks the DDR
# low-power states; let it runtime suspend while the port is idle.
DWC3=/sys/devices/platform/soc@0/a600000.usb/power/control
[ -w "${DWC3}" ] && echo auto > "${DWC3}"

exit 0
