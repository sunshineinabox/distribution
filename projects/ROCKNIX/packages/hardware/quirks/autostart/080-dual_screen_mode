count=$(modetest | awk '$3 == "connected" && $4 !~ /^(DP|HDMI)-/ {print $0}' | wc -l)
# Retroid Dual Screen Add-on
grep -qs Lontium /sys/class/drm/card*-DP-*/edid && count=$((count + 1))

if [ "$count" -eq 2 ]; then
    dual_screen=true
else
    dual_screen=false
fi

cat <<EOF >/storage/.config/profile.d/080-dual_screen_mode
DEVICE_HAS_DUAL_SCREEN=$dual_screen
EOF
