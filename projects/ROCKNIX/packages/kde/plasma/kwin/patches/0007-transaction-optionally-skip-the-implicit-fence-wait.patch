From: sunshineinabox <aqemail@gmail.com>
Date: Tue, 29 Sep 2026 14:00:00 -0700
Subject: [PATCH] transaction: optionally skip the implicit fence wait

KWIN_NO_IMPLICIT_FENCE_WAIT=1 applies implicitly synced buffers right
away. Scanout and the GPU wait for the fence anyway.
---
--- a/src/wayland/transaction.cpp
+++ b/src/wayland/transaction.cpp
@@ -19,6 +19,8 @@
 namespace KWin
 {
 
+static const bool s_waitForImplicitFences = qEnvironmentVariableIntValue("KWIN_NO_IMPLICIT_FENCE_WAIT") == 0;
+
 TransactionFence::TransactionFence(Transaction *transaction, FileDescriptor &&fileDescriptor)
     : m_transaction(transaction)
     , m_fileDescriptor(std::move(fileDescriptor))
@@ -212,7 +214,7 @@
             // Avoid applying the transaction until all graphics buffers have become idle.
             if (entry.state->acquirePoint.timeline) {
                 watchSyncObj(&entry);
-            } else {
+            } else if (s_waitForImplicitFences) {
                 watchDmaBuf(&entry);
             }
         }
