@@ -893,6 +897,23 @@
     }
 }
 
+static bool isAfbcOnly(DrmPlane *plane)
+{
+    const auto formats = plane->formats();
+    if (formats.isEmpty()) {
+        return false;
+    }
+    for (const ModifierList &modifiers : formats) {
+        const bool afbc = !modifiers.isEmpty() && std::ranges::all_of(modifiers, [](uint64_t modifier) {
+            return modifier >> 56 == DRM_FORMAT_MOD_VENDOR_ARM && ((modifier >> 52) & 0xf) == DRM_FORMAT_MOD_ARM_TYPE_AFBC;
+        });
+        if (!afbc) {
+            return false;
+        }
+    }
+    return true;
+}
