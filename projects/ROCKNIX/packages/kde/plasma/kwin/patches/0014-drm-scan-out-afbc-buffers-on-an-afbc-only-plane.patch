+static const bool s_afbcPlanes = environmentVariableBoolValue("KWIN_DRM_AFBC_PLANES").value_or(false);
 
 DrmGpu::DrmGpu(DrmBackend *backend, int fd, std::unique_ptr<DrmDevice> &&device)
