. /etc/profile.d/001-functions

PROFILE=/storage/.config/profile.d/092-kwin
UNIT=/run/systemd/system/essway.service

if [ "$(session_compositor)" = "kwin" ]; then
  echo 'UI_SERVICE="kwin.service essway.service"' > ${PROFILE}
  sed 's/sway\.service/kwin.service/g' /usr/lib/systemd/system/essway.service > ${UNIT}
  mkdir -p ${UNIT}.d
  printf '[Service]\nExecStartPre=-/usr/bin/timeout 30 /bin/sh -c "until [ -e /run/rocknix/kwin-ready ]; do sleep 0.1; done"\n' \
    > ${UNIT}.d/kwin-ready.conf
  systemctl mask --runtime sway.service sway-touch.service touchkeyboard.service >/dev/null 2>&1
  systemctl stop sway-touch.service touchkeyboard.service >/dev/null 2>&1
else
  rm -f ${PROFILE} ${UNIT} ${UNIT}.d/kwin-ready.conf
  systemctl unmask --runtime sway.service sway-touch.service touchkeyboard.service >/dev/null 2>&1
fi
systemctl daemon-reload
