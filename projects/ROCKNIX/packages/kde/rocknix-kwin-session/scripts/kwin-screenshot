import os
import struct
import sys
import zlib

import dbussy
from dbussy import DBUS


def value(meta, key):
    v = meta[key]
    return v[1] if isinstance(v, tuple) else v


def chunk(kind, body):
    return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body))


def write_png(path, width, height, stride, data):
    rows = []
    for y in range(height):
        src = data[y * stride:y * stride + width * 4]
        rgb = bytearray(width * 3)
        rgb[0::3] = src[2::4]
        rgb[1::3] = src[1::4]
        rgb[2::3] = src[0::4]
        rows.append(b"\0" + bytes(rgb))
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n")
        f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)))
        f.write(chunk(b"IDAT", zlib.compress(b"".join(rows), 6)))
        f.write(chunk(b"IEND", b""))


def main():
    args = sys.argv[1:]
    screen = None
    if len(args) == 3 and args[0] == "--screen":
        screen = args[1]
        args = args[2:]
    if len(args) != 1:
        sys.exit("usage: kwin-screenshot [--screen <output>] <file.png>")
    os.environ.setdefault("DBUS_SESSION_BUS_ADDRESS", "unix:path=/var/run/0-runtime-dir/bus")
    conn = dbussy.Connection.bus_get(DBUS.BUS_SESSION, private=False)
    rfd, wfd = os.pipe()
    options = {"include-decoration": ("b", False), "native-resolution": ("b", True)}
    msg = dbussy.Message.new_method_call(destination="org.kde.KWin", path="/org/kde/KWin/ScreenShot2",
                                         iface="org.kde.KWin.ScreenShot2",
                                         method="CaptureScreen" if screen else "CaptureActiveWindow")
    if screen:
        msg.append_objects("sa{sv}h", screen, options, wfd)
    else:
        msg.append_objects("a{sv}h", options, wfd)
    reply = conn.send_with_reply_and_block(msg, timeout=5000)
    os.close(wfd)
    meta = reply.expect_return_objects("a{sv}")[0]
    width, height, stride = value(meta, "width"), value(meta, "height"), value(meta, "stride")
    data = bytearray()
    with os.fdopen(rfd, "rb", buffering=0) as f:
        while len(data) < stride * height:
            part = f.read(stride * height - len(data))
            if not part:
                sys.exit("kwin-screenshot: short read")
            data += part
    write_png(args[0], width, height, stride, bytes(data))


if __name__ == "__main__":
    main()
