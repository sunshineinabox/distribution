Subject: [PATCH] sun4i-h616: set DAC gain and enable the DAC at boot

Upstream's H616 routing leaves the DAC switch off and the gain at reset, so both outputs stay silent.

diff --git a/ucm2/Allwinner/sun4i-h616/HiFi.conf b/ucm2/Allwinner/sun4i-h616/HiFi.conf
--- a/ucm2/Allwinner/sun4i-h616/HiFi.conf
+++ b/ucm2/Allwinner/sun4i-h616/HiFi.conf
@@ -2,6 +2,7 @@
 	Comment "Internal Speaker"
 
 	EnableSequence [
+		cset "name='DAC Playback Volume' 63"
 		cset "name='Speaker Switch' on"
 	]
 
@@ -23,6 +24,10 @@
 SectionDevice."Headphones" {
 	Comment "Headphones"
 
+	EnableSequence [
+		cset "name='DAC Playback Volume' 63"
+	]
+
 	Value {
 		PlaybackMixerElem "Line Out"
 		PlaybackPCM "hw:${CardId},0"
diff --git a/ucm2/Allwinner/sun4i-h616/h616-audio-codec.conf b/ucm2/Allwinner/sun4i-h616/h616-audio-codec.conf
--- a/ucm2/Allwinner/sun4i-h616/h616-audio-codec.conf
+++ b/ucm2/Allwinner/sun4i-h616/h616-audio-codec.conf
@@ -6,3 +6,7 @@
 	File "/Allwinner/sun4i-h616/HiFi.conf"
 	Comment "Play HiFi quality Music"
 }
+
+FixedBootSequence [
+	cset "name='DAC Playback Switch' on"
+]
