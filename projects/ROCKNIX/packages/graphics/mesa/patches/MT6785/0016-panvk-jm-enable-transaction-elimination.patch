+void
+panvk_per_arch(cmd_invalidate_barrier_crcs)(struct panvk_cmd_buffer *cmdbuf,
+                                            const VkDependencyInfo *info)
+{
+   for (uint32_t i = 0; i < info->imageMemoryBarrierCount; i++) {
+      const VkImageMemoryBarrier2 *barrier = &info->pImageMemoryBarriers[i];
+      VK_FROM_HANDLE(panvk_image, image, barrier->image);
+
+      if (barrier->subresourceRange.baseMipLevel == 0 &&
+          (barrier->subresourceRange.aspectMask & VK_IMAGE_ASPECT_COLOR_BIT) &&
+          panvk_image_plane_crc_header_addr(image) &&
+          panvk_image_barrier_invalidates_crc(barrier, image))
+         panvk_per_arch(cmd_invalidate_crc)(cmdbuf, &image->planes[0].plane);
+   }
+}
+
+/* Stored targets that don't get this pass's CRCs keep stale ones */
+static void
+invalidate_unselected_crc_rts(struct panvk_cmd_buffer *cmdbuf)
+{
+   const struct panvk_rendering_state *render = &cmdbuf->state.gfx.render;
+   const struct pan_fb_desc_info info = {
+      .fb = &render->fb.layout,
+      .store = render->fb.needs_store ? &render->fb.store
+                                      : &render->fb.spill.store,
+   };
+   struct pan_fb_crc_rt_info crc_info;
+   bool has_crc_rt = GENX(pan_fb_get_crc_rt_info)(&info, &crc_info);
+
+   for (uint32_t i = 0; i < info.fb->rt_count; i++) {
+      const struct pan_fb_store_target *rt = &info.store->rts[i];
+
+      if (!rt->store || !rt->crc_header_addr ||
+          (has_crc_rt && crc_info.rt == i))
+         continue;
+
+      const struct pan_image_plane_ref ref =
+         pan_image_view_get_color_plane(rt->iview);
+
+      panvk_per_arch(cmd_invalidate_crc)(cmdbuf,
+                                         ref.image->planes[ref.plane_idx]);
+   }
+}
