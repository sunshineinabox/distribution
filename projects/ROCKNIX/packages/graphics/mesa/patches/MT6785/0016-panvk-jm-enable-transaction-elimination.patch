       batch = panvk_per_arch(cmd_open_batch)(cmdbuf);
@@ -1894,6 +1896,30 @@ panvk_per_arch(CmdBeginRendering)(VkCommandBuffer commandBuffer,
 
    if (!cmdbuf->cur_batch)
       panvk_per_arch(cmd_open_batch)(cmdbuf);
+
+   if (resuming)
+      return;
+
+   /* A render pass can do a host-written image's first transition */
+   for (uint32_t i = 0; i < pRenderingInfo->colorAttachmentCount; i++) {
+      const VkRenderingAttachmentInfo *att =
+         &pRenderingInfo->pColorAttachments[i];
+      const VkRenderingAttachmentInitialLayoutInfoMESA *initial =
+         vk_find_struct_const(att->pNext,
+                              RENDERING_ATTACHMENT_INITIAL_LAYOUT_INFO_MESA);
+      VK_FROM_HANDLE(panvk_image_view, iview, att->imageView);
+
+      if (!initial ||
+          initial->initialLayout != VK_IMAGE_LAYOUT_PREINITIALIZED ||
+          !iview || iview->pview.first_level != 0)
+         continue;
+
+      struct panvk_image *image =
+         container_of(iview->vk.image, struct panvk_image, vk);
+
+      if (panvk_image_plane_crc_header_addr(image))
+         panvk_per_arch(cmd_invalidate_crc)(cmdbuf, &image->planes[0].plane);
+   }
 }
 
