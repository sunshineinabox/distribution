-   if (batch->vtc_jc.job_index + (4 * cmdbuf->state.gfx.render.layer_count) >=
+   if (batch->vtc_jc.job_index + (4 * cmdbuf->state.gfx.render.layer_count) +
+          (2 * cmdbuf->state.gfx.render.fb.layout.rt_count) >=
        UINT16_MAX) {
