+static void
+copy_img_desc(const uint32_t *src, uint32_t *attrib, uint32_t *attrib_buf,
+              uint32_t buf_idx)
+{
+   if (!src) {
+      memset(attrib, 0, pan_size(ATTRIBUTE));
+      memset(attrib_buf, 0, pan_size(ATTRIBUTE_BUFFER) * 2);
+      return;
+   }
+
+   bool texel_buf = (src[0] & BITFIELD_MASK(5)) == MALI_ATTRIBUTE_TYPE_1D;
+
+   if (texel_buf) {
+      attrib[0] = (src[4] & ~BITFIELD_MASK(9)) | buf_idx;
+      attrib[1] = src[5];
+   } else {
+      attrib[0] = (src[2] & 0xfffffc00) | buf_idx;
+      attrib[1] = 0;
+   }
+
+   attrib_buf[0] = src[0];
+   attrib_buf[1] = src[1];
+   attrib_buf[2] = src[2] & BITFIELD_MASK(7);
+   attrib_buf[3] = src[3];
+   for (uint32_t i = 4; i < 8; i++)
+      attrib_buf[i] = texel_buf ? 0 : src[i];
+}
+
+/* Bifrost has no update-after-bind, so the tables can be filled at record time */
+void
+panvk_per_arch(cmd_copy_shader_descs)(
+   const struct panvk_descriptor_state *desc_state,
+   const struct panvk_shader_desc_info *desc_info,
+   const struct panvk_shader_desc_state *shader_desc_state,
+   uint32_t attrib_buf_idx_offset)
+{
+   static const uint32_t desc_size[PANVK_BIFROST_DESC_TABLE_COUNT] = {
+      [PANVK_BIFROST_DESC_TABLE_UBO] = pan_size(UNIFORM_BUFFER),
+      [PANVK_BIFROST_DESC_TABLE_TEXTURE] = pan_size(TEXTURE),
+      [PANVK_BIFROST_DESC_TABLE_SAMPLER] = pan_size(SAMPLER),
+   };
+   const uint32_t *handles = panvk_priv_mem_host_addr(desc_info->others.map);
+
+   if (!handles)
+      return;
+
+   for (uint32_t t = 0; t < PANVK_BIFROST_DESC_TABLE_COUNT; t++) {
+      uint8_t *table = shader_desc_state->tables_host[t];
+
+      for (uint32_t i = 0; i < desc_info->others.count[t]; i++) {
+         uint32_t handle = *handles++;
+         const struct panvk_descriptor_set *set =
+            desc_state->sets[COPY_DESC_HANDLE_EXTRACT_TABLE(handle)];
+         uint32_t src_idx = COPY_DESC_HANDLE_EXTRACT_INDEX(handle);
+         const uint32_t *src = NULL;
+
+         if (set && src_idx < set->desc_count)
+            src = (const uint32_t *)((const uint8_t *)set->descs.host +
+                                     src_idx * PANVK_DESCRIPTOR_SIZE);
+
+         if (t == PANVK_BIFROST_DESC_TABLE_IMG) {
+            uint8_t *attribs = shader_desc_state->img_attrib_table_host;
+
+            copy_img_desc(src,
+                          (uint32_t *)(attribs + i * pan_size(ATTRIBUTE)),
+                          (uint32_t *)(table + i * pan_size(ATTRIBUTE_BUFFER) * 2),
+                          i * 2 + attrib_buf_idx_offset);
+         } else if (src) {
+            memcpy(table + i * desc_size[t], src, desc_size[t]);
+         } else {
+            memset(table + i * desc_size[t], 0, desc_size[t]);
+         }
+      }
+   }
+}
 #else
 void
 panvk_per_arch(cmd_fill_dyn_bufs)(
