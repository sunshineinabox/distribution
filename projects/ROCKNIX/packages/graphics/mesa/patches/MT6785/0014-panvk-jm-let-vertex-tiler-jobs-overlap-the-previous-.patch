From a404b03a92fcf98b8ecf61e039989abb4ed4efb1 Mon Sep 17 00:00:00 2001
From: sunshineinabox <aqemail@gmail.com>
Date: Tue, 3 Nov 2026 16:12:59 -0800
Subject: [PATCH] panvk/jm: let vertex/tiler jobs overlap the previous fragment
 job

A batch's fragment job already runs after all earlier jobs, so its
vertex/tiler jobs only need to wait when a barrier, event, query or poly
heap use asks for it. Alternate two tiler heaps so they can overlap the
previous fragment job.
---
 src/panfrost/vulkan/jm/panvk_cmd_buffer.h    |  29 ++-
 src/panfrost/vulkan/jm/panvk_queue.h         |   4 +
 src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c |  34 ++--
 src/panfrost/vulkan/jm/panvk_vX_cmd_query.c  |   3 +
 src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c  | 178 +++++++++++++------
 src/panfrost/vulkan/panvk_device.h           |   4 +-
 src/panfrost/vulkan/panvk_vX_device.c        |  20 ++-
 7 files changed, 194 insertions(+), 78 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
index c13b85b..9b7c0eb 100644
--- a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
+++ b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
@@ -23,6 +23,7 @@
 #include "panvk_device.h"
 #include "panvk_macros.h"
 #include "panvk_mempool.h"
+#include "panvk_priv_bo.h"
 #include "panvk_shader.h"
 
 #include "pan_jc.h"
@@ -54,14 +55,26 @@ struct panvk_batch {
       struct pan_tiler_context ctx;
       struct pan_ptr heap_desc;
       struct pan_ptr ctx_descs;
-      struct mali_tiler_heap_packed heap_templ;
       struct mali_tiler_context_packed ctx_templ;
    } tiler;
    struct pan_tls_info tlsinfo;
    unsigned wls_total_size;
    bool issued;
+
+   /* Wait for all earlier work before the vertex/tiler jobs, not only before
+    * the fragment job. */
+   bool serialize;
 };
 
+/* The fragment job of a batch runs after every job submitted before it, so
+ * dependencies on these stages alone don't hold back the vertex/tiler jobs. */
+#define PANVK_FRAGMENT_STAGES                                                  \
+   (VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |                             \
+    VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT |                                  \
+    VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT |                              \
+    VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT |                          \
+    VK_PIPELINE_STAGE_2_BOTTOM_OF_PIPE_BIT)
+
 enum panvk_cmd_event_op_type {
    PANVK_EVENT_OP_SET,
    PANVK_EVENT_OP_RESET,
@@ -92,6 +105,8 @@ struct panvk_cmd_buffer {
       struct panvk_cmd_compute_state compute;
       struct panvk_push_constant_state push_constants;
       bool uses_poly_heap;
+      /* A barrier asked the next batch to wait for all earlier work */
+      bool serialize_next_batch;
    } state;
 };
 
@@ -135,6 +150,18 @@ panvk_cmd_get_desc_state(struct panvk_cmd_buffer *cmdbuf,
 
 extern const struct vk_command_buffer_ops panvk_per_arch(cmd_buffer_ops);
 
+static inline void
+panvk_per_arch(cmd_emit_tiler_heap)(struct mali_tiler_heap_packed *desc,
+                                    const struct panvk_priv_bo *heap)
+{
+   pan_pack(desc, TILER_HEAP, cfg) {
+      cfg.size = pan_kmod_bo_size(heap->bo);
+      cfg.base = heap->addr.dev;
+      cfg.bottom = heap->addr.dev;
+      cfg.top = cfg.base + cfg.size;
+   }
+}
+
 struct panvk_batch *
    panvk_per_arch(cmd_open_batch)(struct panvk_cmd_buffer *cmdbuf);
 
diff --git a/src/panfrost/vulkan/jm/panvk_queue.h b/src/panfrost/vulkan/jm/panvk_queue.h
index 52bcc2a..2155e4c 100644
--- a/src/panfrost/vulkan/jm/panvk_queue.h
+++ b/src/panfrost/vulkan/jm/panvk_queue.h
@@ -19,6 +19,10 @@
 struct panvk_gpu_queue {
    struct vk_queue vk;
    uint32_t sync;
+   /* Index of the tiler heap the next batch uses */
+   uint32_t tiler_heap;
+   /* A barrier still has to hold back the next vertex/tiler job */
+   bool serialize_pending;
 };
 
 VK_DEFINE_HANDLE_CASTS(panvk_gpu_queue, vk.base, VkQueue, VK_OBJECT_TYPE_QUEUE)
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
index 04c2034..5e55554 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
@@ -79,7 +79,8 @@ panvk_per_arch(cmd_close_batch)(struct panvk_cmd_buffer *cmdbuf)
    if (!batch->fb.desc.gpu && !batch->vtc_jc.first_job) {
       if (util_dynarray_num_elements(&batch->event_ops,
                                      struct panvk_cmd_event_op) == 0) {
-         /* Content-less batch, let's drop it */
+         /* Content-less batch, let's drop it, but not the barrier it holds */
+         cmdbuf->state.serialize_next_batch |= batch->serialize;
          vk_free(&cmdbuf->vk.pool->alloc, batch);
       } else {
          /* Batch has no jobs but is needed for synchronization, let's add a
@@ -279,24 +280,19 @@ panvk_per_arch(cmd_prepare_tiler_context)(struct panvk_cmd_buffer *cmdbuf,
    tiler_desc =
       batch->tiler.ctx_descs.gpu + (pan_size(TILER_CONTEXT) * layer_idx);
 
-   pan_pack(&batch->tiler.heap_templ, TILER_HEAP, cfg) {
-      cfg.size = pan_kmod_bo_size(dev->tiler_heap->bo);
-      cfg.base = dev->tiler_heap->addr.dev;
-      cfg.bottom = dev->tiler_heap->addr.dev;
-      cfg.top = cfg.base + cfg.size;
-   }
-
    pan_pack(&batch->tiler.ctx_templ, TILER_CONTEXT, cfg) {
       cfg.hierarchy_mask = panvk_select_tiler_hierarchy_mask(
-         phys_dev, &cmdbuf->state.gfx, pan_kmod_bo_size(dev->tiler_heap->bo));
+         phys_dev, &cmdbuf->state.gfx,
+         pan_kmod_bo_size(dev->tiler_heaps[0]->bo));
       cfg.fb_width = fb->width_px;
       cfg.fb_height = fb->height_px;
       cfg.heap = batch->tiler.heap_desc.gpu;
       cfg.sample_pattern = pan_sample_pattern(fb->sample_count);
    }
 
-   memcpy(batch->tiler.heap_desc.cpu, &batch->tiler.heap_templ,
-          sizeof(batch->tiler.heap_templ));
+   /* The queue picks the heap at submission */
+   panvk_per_arch(cmd_emit_tiler_heap)(batch->tiler.heap_desc.cpu,
+                                       dev->tiler_heaps[0]);
 
    struct mali_tiler_context_packed *ctxs = batch->tiler.ctx_descs.cpu;
 
@@ -327,6 +323,8 @@ panvk_per_arch(cmd_open_batch)(struct panvk_cmd_buffer *cmdbuf)
    cmdbuf->cur_batch->jobs = UTIL_DYNARRAY_INIT;
    cmdbuf->cur_batch->event_ops = UTIL_DYNARRAY_INIT;
    assert(cmdbuf->cur_batch);
+   cmdbuf->cur_batch->serialize = cmdbuf->state.serialize_next_batch;
+   cmdbuf->state.serialize_next_batch = false;
    return cmdbuf->cur_batch;
 }
 
@@ -337,6 +335,9 @@ panvk_per_arch(cmd_init_poly_heap)(struct panvk_cmd_buffer *cmdbuf,
    struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
    struct panvk_batch *batch = cmdbuf->cur_batch;
 
+   /* poly_heap is shared by every batch on the device */
+   batch->serialize = true;
+
    /* The first time poly_heap is used in a primary command buffer, we need to
     * reset the heap bottom position. */
    if (cmdbuf->state.uses_poly_heap ||
@@ -384,6 +385,17 @@ panvk_per_arch(CmdPipelineBarrier2)(VkCommandBuffer commandBuffer,
                                     const VkDependencyInfo *pDependencyInfo)
 {
    VK_FROM_HANDLE(panvk_cmd_buffer, cmdbuf, commandBuffer);
+   VkPipelineStageFlags2 dst_stages = 0;
+
+   for (uint32_t i = 0; i < pDependencyInfo->memoryBarrierCount; i++)
+      dst_stages |= pDependencyInfo->pMemoryBarriers[i].dstStageMask;
+   for (uint32_t i = 0; i < pDependencyInfo->bufferMemoryBarrierCount; i++)
+      dst_stages |= pDependencyInfo->pBufferMemoryBarriers[i].dstStageMask;
+   for (uint32_t i = 0; i < pDependencyInfo->imageMemoryBarrierCount; i++)
+      dst_stages |= pDependencyInfo->pImageMemoryBarriers[i].dstStageMask;
+
+   if (dst_stages & ~PANVK_FRAGMENT_STAGES)
+      cmdbuf->state.serialize_next_batch = true;
 
    /* Caches are flushed/invalidated at batch boundaries for now, nothing to do
     * for memory barriers assuming we implement barriers with the creation of a
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_query.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_query.c
index e2d79e3..eed55b0 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_query.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_query.c
@@ -69,6 +69,9 @@ open_batch(struct panvk_cmd_buffer *cmd, bool *had_batch)
 
    *had_batch = res;
 
+   /* Query results come from earlier batches */
+   cmd->cur_batch->serialize = true;
+
    return cmd->cur_batch;
 }
 
diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index 31a921d..166c411 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -34,13 +34,17 @@
 static void
 panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
                          struct panvk_cmd_buffer *cmdbuf,
-                         struct panvk_batch *batch, uint32_t *bos,
-                         unsigned nr_bos, uint32_t *in_fences,
-                         unsigned nr_in_fences)
+                         struct panvk_batch *batch,
+                         const struct panvk_priv_bo *heap, uint32_t *vtc_bos,
+                         unsigned nr_vtc_bos, uint32_t *frag_bos,
+                         unsigned nr_frag_bos, uint32_t *vtc_waits,
+                         unsigned nr_vtc_waits, uint32_t *frag_waits,
+                         unsigned nr_frag_waits)
 {
    struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
    struct panvk_physical_device *phys_dev =
       to_panvk_physical_device(dev->vk.physical);
+   bool flush_descs = batch->issued;
    ASSERTED int ret;
 
    /* Reset the batch if it's already been issued */
@@ -50,30 +54,34 @@ panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
 
       /* Reset the tiler before re-issuing the batch */
       if (batch->tiler.ctx_descs.cpu) {
-         memcpy(batch->tiler.heap_desc.cpu, &batch->tiler.heap_templ,
-                sizeof(batch->tiler.heap_templ));
-
          struct mali_tiler_context_packed *ctxs = batch->tiler.ctx_descs.cpu;
 
          for (uint32_t i = 0; i < batch->fb.layer_count; i++)
             memcpy(&ctxs[i], &batch->tiler.ctx_templ, sizeof(*ctxs));
       }
+   }
 
-      /* We don't keep track of BO <-> job relationship, so let's just flush the
-       * whole desc pool for now. */
-      panvk_pool_flush_maps(&cmdbuf->desc_pool);
+   /* The batch was recorded with heap 0 */
+   if (heap && (batch->issued || heap != dev->tiler_heaps[0])) {
+      panvk_per_arch(cmd_emit_tiler_heap)(batch->tiler.heap_desc.cpu, heap);
+      flush_descs = true;
    }
 
+   /* We don't keep track of BO <-> job relationship, so let's just flush the
+    * whole desc pool for now. */
+   if (flush_descs)
+      panvk_pool_flush_maps(&cmdbuf->desc_pool);
+
    /* Flush pending synchronization requests before submitting the job, to
     * make sure things are GPU-visible. */
    pan_kmod_flush_bo_map_syncs(dev->kmod.dev);
 
    if (batch->vtc_jc.first_job) {
       struct drm_panfrost_submit submit = {
-         .bo_handles = (uintptr_t)bos,
-         .bo_handle_count = nr_bos,
-         .in_syncs = (uintptr_t)in_fences,
-         .in_sync_count = nr_in_fences,
+         .bo_handles = (uintptr_t)vtc_bos,
+         .bo_handle_count = nr_vtc_bos,
+         .in_syncs = (uintptr_t)vtc_waits,
+         .in_sync_count = nr_vtc_waits,
          .out_sync = queue->sync,
          .jc = batch->vtc_jc.first_job,
       };
@@ -107,21 +115,15 @@ panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
 
    if (batch->frag_jc.first_job) {
       struct drm_panfrost_submit submit = {
-         .bo_handles = (uintptr_t)bos,
-         .bo_handle_count = nr_bos,
+         .bo_handles = (uintptr_t)frag_bos,
+         .bo_handle_count = nr_frag_bos,
+         .in_syncs = (uintptr_t)frag_waits,
+         .in_sync_count = nr_frag_waits,
          .out_sync = queue->sync,
          .jc = batch->frag_jc.first_job,
          .requirements = PANFROST_JD_REQ_FS,
       };
 
-      if (batch->vtc_jc.first_job) {
-         submit.in_syncs = (uintptr_t)(&queue->sync);
-         submit.in_sync_count = 1;
-      } else {
-         submit.in_syncs = (uintptr_t)in_fences;
-         submit.in_sync_count = nr_in_fences;
-      }
-
       ret = pan_kmod_ioctl(dev->drm_fd, DRM_IOCTL_PANFROST_SUBMIT, &submit);
       assert(!ret);
       if (PANVK_DEBUG(TRACE) || PANVK_DEBUG(SYNC)) {
@@ -153,6 +155,20 @@ panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
    batch->issued = true;
 }
 
+/* Merge identical BO entries. */
+static void
+merge_bo_handles(uint32_t *bos, unsigned *nr_bos)
+{
+   for (unsigned x = 0; x < *nr_bos; x++) {
+      for (unsigned y = x + 1; y < *nr_bos;) {
+         if (bos[x] == bos[y])
+            bos[y] = bos[--(*nr_bos)];
+         else
+            y++;
+      }
+   }
+}
+
 static void
 panvk_queue_transfer_sync(struct panvk_gpu_queue *queue, uint32_t syncobj)
 {
@@ -236,16 +252,20 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
    struct panvk_gpu_queue *queue = container_of(vk_queue, struct panvk_gpu_queue, vk);
    struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
 
-   unsigned nr_semaphores = submit->wait_count + 1;
-   uint32_t semaphores[nr_semaphores];
+   /* Waits that only fragment jobs need are left to them */
+   uint32_t early_waits[submit->wait_count + 1];
+   uint32_t late_waits[submit->wait_count + 1];
+   unsigned nr_early_waits = 0, nr_late_waits = 0;
 
-   semaphores[0] = queue->sync;
    for (unsigned i = 0; i < submit->wait_count; i++) {
       assert(vk_sync_type_is_drm_syncobj(submit->waits[i].sync->type));
       struct vk_drm_syncobj *syncobj =
          vk_sync_as_drm_syncobj(submit->waits[i].sync);
 
-      semaphores[i + 1] = syncobj->syncobj;
+      if (submit->waits[i].stage_mask & ~PANVK_FRAGMENT_STAGES)
+         early_waits[nr_early_waits++] = syncobj->syncobj;
+      else
+         late_waits[nr_late_waits++] = syncobj->syncobj;
    }
 
    for (uint32_t j = 0; j < submit->command_buffer_count; ++j) {
@@ -263,15 +283,24 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
       }
 
       list_for_each_entry(struct panvk_batch, batch, &cmdbuf->batches, node) {
+         /* Alternating heaps keeps implicit fencing on the heap BO from
+          * ordering a batch after the previous one's fragment job */
+         const struct panvk_priv_bo *heap = NULL;
+         if (batch->tiler.heap_desc.cpu) {
+            heap = dev->tiler_heaps[queue->tiler_heap];
+            queue->tiler_heap = (queue->tiler_heap + 1) %
+                                ARRAY_SIZE(dev->tiler_heaps);
+         }
+
          /* FIXME: should be done at the batch level */
-         unsigned nr_bos = panvk_pool_num_bos(&cmdbuf->desc_pool) +
-                           panvk_pool_num_bos(&cmdbuf->varying_pool) +
-                           panvk_pool_num_bos(&cmdbuf->tls_pool) +
-                           batch->fb.bo_count + (batch->blit.src ? 1 : 0) +
-                           (batch->blit.dst ? 1 : 0) +
-                           (batch->vtc_jc.first_tiler ? 1 : 0) + 1;
+         unsigned nr_vtc_bos = panvk_pool_num_bos(&cmdbuf->desc_pool) +
+                               panvk_pool_num_bos(&cmdbuf->varying_pool) +
+                               panvk_pool_num_bos(&cmdbuf->tls_pool) +
+                               (batch->blit.src ? 1 : 0) +
+                               (batch->blit.dst ? 1 : 0) + (heap ? 1 : 0);
+         unsigned nr_frag_bos = nr_vtc_bos + batch->fb.bo_count + 1;
          unsigned bo_idx = 0;
-         uint32_t bos[nr_bos];
+         uint32_t bos[nr_frag_bos];
 
          panvk_pool_get_bo_handles(&cmdbuf->desc_pool, &bos[bo_idx]);
          bo_idx += panvk_pool_num_bos(&cmdbuf->desc_pool);
@@ -282,46 +311,81 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
          panvk_pool_get_bo_handles(&cmdbuf->tls_pool, &bos[bo_idx]);
          bo_idx += panvk_pool_num_bos(&cmdbuf->tls_pool);
 
-         for (unsigned i = 0; i < batch->fb.bo_count; i++)
-            bos[bo_idx++] = pan_kmod_bo_handle(batch->fb.bos[i]);
-
          if (batch->blit.src)
             bos[bo_idx++] = pan_kmod_bo_handle(batch->blit.src);
 
          if (batch->blit.dst)
             bos[bo_idx++] = pan_kmod_bo_handle(batch->blit.dst);
 
-         if (batch->vtc_jc.first_tiler)
-            bos[bo_idx++] = pan_kmod_bo_handle(dev->tiler_heap->bo);
+         if (heap)
+            bos[bo_idx++] = pan_kmod_bo_handle(heap->bo);
+
+         /* Only fragment jobs use the attachments and sample positions, so
+          * implicit fencing on them need not hold back vertex/tiler jobs */
+         uint32_t vtc_bos[nr_vtc_bos];
+         memcpy(vtc_bos, bos, nr_vtc_bos * sizeof(*bos));
+
+         for (unsigned i = 0; i < batch->fb.bo_count; i++)
+            bos[bo_idx++] = pan_kmod_bo_handle(batch->fb.bos[i]);
 
          bos[bo_idx++] = pan_kmod_bo_handle(dev->sample_positions->bo);
-         assert(bo_idx == nr_bos);
-
-         /* Merge identical BO entries. */
-         for (unsigned x = 0; x < nr_bos; x++) {
-            for (unsigned y = x + 1; y < nr_bos;) {
-               if (bos[x] == bos[y])
-                  bos[y] = bos[--nr_bos];
-               else
-                  y++;
-            }
-         }
+         assert(bo_idx == nr_frag_bos);
+
+         merge_bo_handles(vtc_bos, &nr_vtc_bos);
+         merge_bo_handles(bos, &nr_frag_bos);
 
-         unsigned nr_in_fences = 0;
          unsigned max_wait_event_syncobjs = util_dynarray_num_elements(
             &batch->event_ops, struct panvk_cmd_event_op);
-         uint32_t in_fences[nr_semaphores + max_wait_event_syncobjs];
-         memcpy(in_fences, semaphores, nr_semaphores * sizeof(*in_fences));
-         nr_in_fences += nr_semaphores;
+         uint32_t vtc_waits[1 + submit->wait_count + max_wait_event_syncobjs];
+         uint32_t frag_waits[1 + submit->wait_count + max_wait_event_syncobjs];
+         unsigned nr_vtc_waits = 0, nr_frag_waits = 0;
+
+         /* Vertex/tiler jobs only wait for earlier work when asked to, or
+          * when there is no fragment job to carry the ordering */
+         bool serialize = batch->serialize || queue->serialize_pending;
+         bool overlap = !serialize && batch->vtc_jc.first_job &&
+                        batch->frag_jc.first_job && !max_wait_event_syncobjs;
+
+         if (!overlap) {
+            vtc_waits[nr_vtc_waits++] = queue->sync;
+            memcpy(&vtc_waits[nr_vtc_waits], late_waits,
+                   nr_late_waits * sizeof(*late_waits));
+            nr_vtc_waits += nr_late_waits;
+         }
+         memcpy(&vtc_waits[nr_vtc_waits], early_waits,
+                nr_early_waits * sizeof(*early_waits));
+         nr_vtc_waits += nr_early_waits;
+
+         panvk_add_wait_event_syncobjs(batch, vtc_waits, &nr_vtc_waits);
+
+         if (batch->vtc_jc.first_job) {
+            /* Holds the batch's vertex/tiler job once it is submitted */
+            frag_waits[nr_frag_waits++] = queue->sync;
+            if (overlap) {
+               memcpy(&frag_waits[nr_frag_waits], late_waits,
+                      nr_late_waits * sizeof(*late_waits));
+               nr_frag_waits += nr_late_waits;
+            }
+         } else {
+            memcpy(frag_waits, vtc_waits, nr_vtc_waits * sizeof(*vtc_waits));
+            nr_frag_waits = nr_vtc_waits;
+         }
 
-         panvk_add_wait_event_syncobjs(batch, in_fences, &nr_in_fences);
+         panvk_queue_submit_batch(queue, cmdbuf, batch, heap, vtc_bos,
+                                  nr_vtc_bos, bos, nr_frag_bos, vtc_waits,
+                                  nr_vtc_waits, frag_waits, nr_frag_waits);
 
-         panvk_queue_submit_batch(queue, cmdbuf, batch, bos, nr_bos, in_fences,
-                                  nr_in_fences);
+         /* A vertex/tiler job that waited for all earlier work holds back
+          * every later one on its slot; a fragment-only batch can't. */
+         queue->serialize_pending =
+            !batch->vtc_jc.first_job && serialize;
 
          panvk_signal_event_syncobjs(queue, batch);
       }
 
+      /* Barriers recorded after the last batch apply to the next one */
+      queue->serialize_pending |= cmdbuf->state.serialize_next_batch;
+
       if (simultaneous) {
          if (!cmdbuf->last_submit &&
              pan_kmod_sync_create(dev->kmod.dev, 0, &cmdbuf->last_submit))
diff --git a/src/panfrost/vulkan/panvk_device.h b/src/panfrost/vulkan/panvk_device.h
index 2ee2e8b..1052d43 100644
--- a/src/panfrost/vulkan/panvk_device.h
+++ b/src/panfrost/vulkan/panvk_device.h
@@ -67,7 +67,9 @@ struct panvk_device {
       struct pan_kmod_allocator allocator;
    } kmod;
 
-   struct panvk_priv_bo *tiler_heap;
+   /* JM batches alternate between them, so a batch's vertex/tiler jobs can run
+    * while the previous batch's fragment job still reads its heap. */
+   struct panvk_priv_bo *tiler_heaps[2];
    struct panvk_priv_bo *sample_positions;
 
    struct {
diff --git a/src/panfrost/vulkan/panvk_vX_device.c b/src/panfrost/vulkan/panvk_vX_device.c
