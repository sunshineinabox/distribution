From 6163677a6a56b3d1c1b1effc14682ffa21cde1e3 Mon Sep 17 00:00:00 2001
From: sunshineinabox <aqemail@gmail.com>
Date: Fri, 6 Nov 2026 15:12:36 -0800
Subject: [PATCH] panvk/jm: submit consecutive batches as one pair of job
 chains

Join consecutive batches that don't wait for earlier work into one
vertex/tiler and one fragment chain, with a barriered cache flush between
them, so the kernel schedules far fewer job chains. PANVK_DEBUG=no_join
submits batches one by one.
---
 src/panfrost/vulkan/jm/panvk_cmd_buffer.h    |  10 ++
 src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c | 130 +++++++++++++++++++
 src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c   |   2 +-
 src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c  | 104 ++++++++++-----
 src/panfrost/vulkan/panvk_device.h           |   6 +-
 src/panfrost/vulkan/panvk_instance.c         |   1 +
 src/panfrost/vulkan/panvk_instance.h         |   1 +
 7 files changed, 216 insertions(+), 38 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
index 4acbabe..4df70e4 100644
--- a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
+++ b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
@@ -64,6 +64,16 @@ struct panvk_batch {
    /* Wait for all earlier work before the vertex/tiler jobs, not only before
     * the fragment job. */
    bool serialize;
+
+   /* Job indices continue from the batch before so chains can be joined.
+    * Jobs start at base + 2; base + 1 is kept for the joining cache flush. */
+   uint32_t vtc_index_base, frag_index_base;
+   /* The indices started over, so this batch can't join the one before */
+   bool no_join;
+   /* Joined to an earlier batch's chains and submitted with them */
+   bool is_joined;
+   /* Number of batches joined to this one's chains */
+   uint32_t joined;
 };
 
 /* The fragment job of a batch runs after every job submitted before it, so
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
index 95b40bc..483b155 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
@@ -380,6 +380,23 @@ panvk_per_arch(cmd_open_batch)(struct panvk_cmd_buffer *cmdbuf)
    cmdbuf->cur_batch->jobs = UTIL_DYNARRAY_INIT;
    cmdbuf->cur_batch->event_ops = UTIL_DYNARRAY_INIT;
    assert(cmdbuf->cur_batch);
+
+   struct panvk_batch *batch = cmdbuf->cur_batch;
+   if (!list_is_empty(&cmdbuf->batches)) {
+      const struct panvk_batch *prev =
+         list_last_entry(&cmdbuf->batches, struct panvk_batch, node);
+
+      batch->vtc_index_base = prev->vtc_jc.job_index;
+      batch->frag_index_base = prev->frag_jc.job_index;
+   }
+
+   if (MAX2(batch->vtc_index_base, batch->frag_index_base) > INT16_MAX) {
+      batch->vtc_index_base = batch->frag_index_base = 0;
+      batch->no_join = true;
+   }
+
+   batch->vtc_jc.job_index = batch->vtc_index_base + 1;
+   batch->frag_jc.job_index = batch->frag_index_base + 1;
    cmdbuf->cur_batch->serialize = cmdbuf->state.serialize_next_batch;
    cmdbuf->state.serialize_next_batch = false;
    return cmdbuf->cur_batch;
@@ -441,12 +458,125 @@ panvk_per_arch(cmd_init_poly_heap)(struct panvk_cmd_buffer *cmdbuf,
    return VK_SUCCESS;
 }
 
+/* Batches are joined with a barriered cache flush between them. A group takes
+ * at most half the tiler heaps so the next group can use the other half. */
+#define PANVK_JOIN_MAX_BATCHES 16
+
+static struct mali_job_header_packed *
+panvk_batch_find_job(const struct panvk_batch *batch, uint32_t index, bool frag)
+{
+   util_dynarray_foreach(&batch->jobs, void *, job) {
+      pan_unpack((const struct mali_job_header_packed *)*job, JOB_HEADER, hdr);
+
+      if (hdr.index == index && (hdr.type == MALI_JOB_TYPE_FRAGMENT) == frag)
+         return *job;
+   }
+
+   return NULL;
+}
+
+static void
+panvk_join_chain(struct panvk_batch *head, struct pan_jc *dst,
+                 const struct pan_jc *src,
+                 struct mali_job_header_packed *src_first,
+                 struct pan_ptr flush, uint32_t flush_index)
+{
+   if (!src->first_job)
+      return;
+
+   if (!dst->first_job) {
+      *dst = *src;
+      return;
+   }
+
+   pan_section_pack(flush.cpu, CACHE_FLUSH_JOB, PAYLOAD, cfg) {
+      cfg.clean_shader_core_ls = true;
+      cfg.invalidate_shader_core_ls = true;
+      cfg.invalidate_shader_core_other = true;
+   }
+
+   pan_section_pack(flush.cpu, CACHE_FLUSH_JOB, HEADER, cfg) {
+      cfg.type = MALI_JOB_TYPE_CACHE_FLUSH;
+      cfg.barrier = true;
+      cfg.index = flush_index;
+      cfg.next = src->first_job;
+   }
+   util_dynarray_append(&head->jobs, flush.cpu);
+
+   pan_unpack(src_first, JOB_HEADER, first);
+   first.barrier = true;
+   pan_pack(src_first, JOB_HEADER, cfg) {
+      cfg = first;
+   }
+
+   dst->prev_job->opaque[6] = flush.gpu;
+   dst->prev_job->opaque[7] = flush.gpu >> 32;
+   dst->prev_job = src->prev_job;
+   dst->job_index = src->job_index;
+}
+
+static void
+panvk_join_batches(struct panvk_cmd_buffer *cmdbuf)
+{
+   struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+   const uint32_t max_tiler_batches = ARRAY_SIZE(dev->tiler_heaps) / 2;
+   struct panvk_batch *head = NULL;
+   uint32_t tiler_batches = 0;
+
+   if (PANVK_DEBUG(NO_JOIN))
+      return;
+
+   list_for_each_entry(struct panvk_batch, batch, &cmdbuf->batches, node) {
+      const bool tiler = batch->tiler.heap_desc.cpu != NULL;
+      bool joinable =
+         head && !batch->no_join && !batch->serialize &&
+         !util_dynarray_num_elements(&batch->event_ops,
+                                     struct panvk_cmd_event_op) &&
+         !util_dynarray_num_elements(&head->event_ops,
+                                     struct panvk_cmd_event_op) &&
+         head->joined + 1 < PANVK_JOIN_MAX_BATCHES &&
+         (!tiler || tiler_batches < max_tiler_batches);
+
+      struct mali_job_header_packed *vtc_first = NULL, *frag_first = NULL;
+      struct pan_ptr vtc_flush = {0}, frag_flush = {0};
+
+      if (joinable && batch->vtc_jc.first_job && head->vtc_jc.first_job) {
+         vtc_first = panvk_batch_find_job(batch, batch->vtc_index_base + 2,
+                                          false);
+         vtc_flush = panvk_cmd_alloc_desc(cmdbuf, CACHE_FLUSH_JOB);
+         joinable = vtc_first && vtc_flush.gpu;
+      }
+
+      if (joinable && batch->frag_jc.first_job && head->frag_jc.first_job) {
+         frag_first = panvk_batch_find_job(batch, batch->frag_index_base + 2,
+                                           true);
+         frag_flush = panvk_cmd_alloc_desc(cmdbuf, CACHE_FLUSH_JOB);
+         joinable = frag_first && frag_flush.gpu;
+      }
+
+      if (!joinable) {
+         head = batch;
+         tiler_batches = tiler;
+         continue;
+      }
+
+      panvk_join_chain(head, &head->vtc_jc, &batch->vtc_jc, vtc_first,
+                       vtc_flush, batch->vtc_index_base + 1);
+      panvk_join_chain(head, &head->frag_jc, &batch->frag_jc, frag_first,
+                       frag_flush, batch->frag_index_base + 1);
+      batch->is_joined = true;
+      head->joined++;
+      tiler_batches += tiler;
+   }
+}
+
 VKAPI_ATTR VkResult VKAPI_CALL
 panvk_per_arch(EndCommandBuffer)(VkCommandBuffer commandBuffer)
 {
    VK_FROM_HANDLE(panvk_cmd_buffer, cmdbuf, commandBuffer);
 
    panvk_per_arch(cmd_close_batch)(cmdbuf);
+   panvk_join_batches(cmdbuf);
 
    panvk_pool_flush_maps(&cmdbuf->desc_pool);
 
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index 31035f5..4c89047 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -1705,7 +1705,7 @@ panvk_cmd_draw_indirect(struct panvk_cmd_buffer *cmdbuf,
     * the same time, because of how TLS works on Mali, we should not split too
     * much as this will cause the TLS budget to go crazy.
     */
-   if (batch->vtc_jc.job_index > (5 * 1024)) {
+   if (batch->vtc_jc.job_index - batch->vtc_index_base > (5 * 1024)) {
       panvk_per_arch(cmd_close_batch)(cmdbuf);
       batch = panvk_per_arch(cmd_open_batch)(cmdbuf);
       cmdbuf->state.uses_poly_heap = false;
diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index f7b77d1..7f79f23 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -31,21 +31,13 @@
 
 #include "drm-uapi/panfrost_drm.h"
 
-static void
-panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
-                         struct panvk_cmd_buffer *cmdbuf,
-                         struct panvk_batch *batch,
-                         const struct panvk_priv_bo *heap, uint32_t *vtc_bos,
-                         unsigned nr_vtc_bos, uint32_t *frag_bos,
-                         unsigned nr_frag_bos, uint32_t *vtc_waits,
-                         unsigned nr_vtc_waits, uint32_t *frag_waits,
-                         unsigned nr_frag_waits)
+/* Readies a batch's descriptors for submission with the given tiler heap and
+ * returns whether they changed. */
+static bool
+panvk_queue_prepare_batch(struct panvk_device *dev, struct panvk_batch *batch,
+                          const struct panvk_priv_bo *heap)
 {
-   struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
-   struct panvk_physical_device *phys_dev =
-      to_panvk_physical_device(dev->vk.physical);
    bool flush_descs = batch->issued;
-   ASSERTED int ret;
 
    /* Reset the batch if it's already been issued */
    if (batch->issued) {
@@ -67,6 +59,24 @@ panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
       flush_descs = true;
    }
 
+   batch->issued = true;
+   return flush_descs;
+}
+
+static void
+panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
+                         struct panvk_cmd_buffer *cmdbuf,
+                         struct panvk_batch *batch, bool flush_descs,
+                         uint32_t *vtc_bos, unsigned nr_vtc_bos,
+                         uint32_t *frag_bos, unsigned nr_frag_bos,
+                         uint32_t *vtc_waits, unsigned nr_vtc_waits,
+                         uint32_t *frag_waits, unsigned nr_frag_waits)
+{
+   struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
+   struct panvk_physical_device *phys_dev =
+      to_panvk_physical_device(dev->vk.physical);
+   ASSERTED int ret;
+
    /* We don't keep track of BO <-> job relationship, so let's just flush the
     * whole desc pool for now. */
    if (flush_descs)
@@ -151,8 +161,6 @@ panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
 
    if (PANVK_DEBUG(TRACE))
       pandecode_next_frame(dev->debug.decode_ctx);
-
-   batch->issued = true;
 }
 
 /* Merge identical BO entries. */
@@ -283,31 +291,54 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
       }
 
       list_for_each_entry(struct panvk_batch, batch, &cmdbuf->batches, node) {
-         /* Alternating heaps keeps implicit fencing on the heap BO from
-          * ordering a batch after the previous one's fragment job */
-         const struct panvk_priv_bo *heap = NULL;
-         if (batch->tiler.heap_desc.cpu) {
-            heap = dev->tiler_heaps[queue->tiler_heap];
-            queue->tiler_heap = (queue->tiler_heap + 1) %
-                                ARRAY_SIZE(dev->tiler_heaps);
+         /* Joined batches are submitted with the batch they joined */
+         if (batch->is_joined)
+            continue;
+
+         /* Batches take the heaps in turn, so implicit fencing on a heap only
+          * orders a batch after the fragment job that last used it */
+         const struct panvk_priv_bo *heaps[ARRAY_SIZE(dev->tiler_heaps)];
+         unsigned nr_heaps = 0, nr_blit_bos = 0, nr_fb_bos = 0;
+         bool flush_descs = false;
+         struct panvk_batch *member = batch;
+
+         for (uint32_t i = 0; i <= batch->joined; i++) {
+            const struct panvk_priv_bo *heap = NULL;
+
+            if (member->tiler.heap_desc.cpu) {
+               heap = dev->tiler_heaps[queue->tiler_heap];
+               queue->tiler_heap = (queue->tiler_heap + 1) %
+                                   ARRAY_SIZE(dev->tiler_heaps);
+               heaps[nr_heaps++] = heap;
+            }
+
+            flush_descs |= panvk_queue_prepare_batch(dev, member, heap);
+            nr_blit_bos += (member->blit.src ? 1 : 0) +
+                           (member->blit.dst ? 1 : 0);
+            nr_fb_bos += member->fb.bo_count;
+            member = list_entry(member->node.next, struct panvk_batch, node);
          }
 
          /* The command buffer pools are private, so keep them off the BO
           * lists where implicit fencing would serialize the batches */
-         unsigned nr_vtc_bos = (batch->blit.src ? 1 : 0) +
-                               (batch->blit.dst ? 1 : 0) + (heap ? 1 : 0);
-         unsigned nr_frag_bos = nr_vtc_bos + batch->fb.bo_count + 1;
+         unsigned nr_vtc_bos = nr_blit_bos + nr_heaps;
+         unsigned nr_frag_bos = nr_vtc_bos + nr_fb_bos + 1;
          unsigned bo_idx = 0;
          uint32_t bos[nr_frag_bos];
 
-         if (batch->blit.src)
-            bos[bo_idx++] = pan_kmod_bo_handle(batch->blit.src);
+         member = batch;
+         for (uint32_t i = 0; i <= batch->joined; i++) {
+            if (member->blit.src)
+               bos[bo_idx++] = pan_kmod_bo_handle(member->blit.src);
+
+            if (member->blit.dst)
+               bos[bo_idx++] = pan_kmod_bo_handle(member->blit.dst);
 
-         if (batch->blit.dst)
-            bos[bo_idx++] = pan_kmod_bo_handle(batch->blit.dst);
+            member = list_entry(member->node.next, struct panvk_batch, node);
+         }
 
-         if (heap)
-            bos[bo_idx++] = pan_kmod_bo_handle(heap->bo);
+         for (unsigned i = 0; i < nr_heaps; i++)
+            bos[bo_idx++] = pan_kmod_bo_handle(heaps[i]->bo);
 
          /* Only fragment jobs use the attachments and sample positions, so
           * implicit fencing on them need not hold back vertex/tiler jobs */
@@ -314,8 +342,13 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
          uint32_t vtc_bos[MAX2(nr_vtc_bos, 1)];
          memcpy(vtc_bos, bos, nr_vtc_bos * sizeof(*bos));
 
-         for (unsigned i = 0; i < batch->fb.bo_count; i++)
-            bos[bo_idx++] = pan_kmod_bo_handle(batch->fb.bos[i]);
+         member = batch;
+         for (uint32_t i = 0; i <= batch->joined; i++) {
+            for (unsigned j = 0; j < member->fb.bo_count; j++)
+               bos[bo_idx++] = pan_kmod_bo_handle(member->fb.bos[j]);
+
+            member = list_entry(member->node.next, struct panvk_batch, node);
+         }
 
          bos[bo_idx++] = pan_kmod_bo_handle(dev->sample_positions->bo);
          assert(bo_idx == nr_frag_bos);
@@ -360,7 +393,7 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
             nr_frag_waits = nr_vtc_waits;
          }
 
-         panvk_queue_submit_batch(queue, cmdbuf, batch, heap, vtc_bos,
+         panvk_queue_submit_batch(queue, cmdbuf, batch, flush_descs, vtc_bos,
                                   nr_vtc_bos, bos, nr_frag_bos, vtc_waits,
                                   nr_vtc_waits, frag_waits, nr_frag_waits);
 
diff --git a/src/panfrost/vulkan/panvk_device.h b/src/panfrost/vulkan/panvk_device.h
index 1052d43..0cf1a1c 100644
--- a/src/panfrost/vulkan/panvk_device.h
+++ b/src/panfrost/vulkan/panvk_device.h
@@ -67,9 +67,9 @@ struct panvk_device {
       struct pan_kmod_allocator allocator;
    } kmod;
 
-   /* JM batches alternate between them, so a batch's vertex/tiler jobs can run
