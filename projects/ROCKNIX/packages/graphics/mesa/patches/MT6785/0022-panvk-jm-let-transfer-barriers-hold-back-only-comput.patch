From 82469f19af5b6c0481075023aa8ae3e9ccb748aa Mon Sep 17 00:00:00 2001
From: sunshineinabox <aqemail@gmail.com>
Date: Fri, 6 Nov 2026 09:46:17 -0800
Subject: [PATCH] panvk/jm: let transfer barriers hold back only compute jobs

Clears, blits and draw-based copies run in order on the fragment slot, so
a transfer barrier only needs to hold back the next compute job. A top of
pipe destination orders nothing.
---
 src/panfrost/vulkan/jm/panvk_cmd_buffer.h     |  9 ++++++++
 src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c  | 23 ++++++++++++++++++-
 .../vulkan/jm/panvk_vX_cmd_dispatch.c         |  1 +
 src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c   |  3 ++-
 src/panfrost/vulkan/panvk_vX_cmd_meta.c       |  6 +++++
 5 files changed, 40 insertions(+), 2 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
index f2132d6..e7f810c 100644
--- a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
+++ b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
@@ -75,6 +75,11 @@ struct panvk_batch {
     VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT |                          \
     VK_PIPELINE_STAGE_2_BOTTOM_OF_PIPE_BIT)
 
+#define PANVK_TRANSFER_STAGES                                                  \
+   (VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT | VK_PIPELINE_STAGE_2_COPY_BIT |      \
+    VK_PIPELINE_STAGE_2_RESOLVE_BIT | VK_PIPELINE_STAGE_2_BLIT_BIT |           \
+    VK_PIPELINE_STAGE_2_CLEAR_BIT)
+
 enum panvk_cmd_event_op_type {
    PANVK_EVENT_OP_SET,
    PANVK_EVENT_OP_RESET,
@@ -107,6 +112,8 @@ struct panvk_cmd_buffer {
       bool uses_poly_heap;
       /* A barrier asked the next batch to wait for all earlier work */
       bool serialize_next_batch;
+      /* A transfer barrier asked the next compute job to do the same */
+      bool serialize_next_compute;
    } state;
 };
 
@@ -167,6 +174,8 @@ struct panvk_batch *
 
 void panvk_per_arch(cmd_close_batch)(struct panvk_cmd_buffer *cmdbuf);
 
+void panvk_per_arch(cmd_serialize_compute)(struct panvk_cmd_buffer *cmdbuf);
+
 struct pan_image_plane;
 
 void panvk_per_arch(cmd_invalidate_crc)(struct panvk_cmd_buffer *cmdbuf,
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
index e49ecd5..0ff5147 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
@@ -377,6 +377,19 @@ panvk_per_arch(cmd_open_batch)(struct panvk_cmd_buffer *cmdbuf)
    return cmdbuf->cur_batch;
 }
 
+void
+panvk_per_arch(cmd_serialize_compute)(struct panvk_cmd_buffer *cmdbuf)
+{
+   if (!cmdbuf->state.serialize_next_compute)
+      return;
+
+   if (!cmdbuf->cur_batch)
+      panvk_per_arch(cmd_open_batch)(cmdbuf);
+
+   cmdbuf->cur_batch->serialize = true;
+   cmdbuf->state.serialize_next_compute = false;
+}
+
 VkResult
 panvk_per_arch(cmd_init_poly_heap)(struct panvk_cmd_buffer *cmdbuf,
                                    unsigned *job_id)
@@ -446,8 +459,16 @@ panvk_per_arch(CmdPipelineBarrier2)(VkCommandBuffer commandBuffer,
    for (uint32_t i = 0; i < pDependencyInfo->imageMemoryBarrierCount; i++)
       dst_stages |= pDependencyInfo->pImageMemoryBarriers[i].dstStageMask;
 
-   if (dst_stages & ~PANVK_FRAGMENT_STAGES)
+   /* Transfers that run as draws are ordered by the fragment job slot, so a
+    * barrier for transfers only holds back the next compute job. */
+   VkPipelineStageFlags2 other_stages =
+      dst_stages &
+      ~(PANVK_FRAGMENT_STAGES | VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT);
+
+   if (other_stages & ~PANVK_TRANSFER_STAGES)
       cmdbuf->state.serialize_next_batch = true;
+   else if (other_stages)
+      cmdbuf->state.serialize_next_compute = true;
 
    /* Caches are flushed/invalidated at batch boundaries for now, nothing to do
     * for memory barriers assuming we implement barriers with the creation of a
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_dispatch.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_dispatch.c
index 5765d7c..b494a66 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_dispatch.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_dispatch.c
@@ -73,6 +73,7 @@ cmd_dispatch(struct panvk_cmd_buffer *cmdbuf, struct panvk_dispatch_info *info)
 
    panvk_per_arch(cmd_close_batch)(cmdbuf);
    struct panvk_batch *batch = panvk_per_arch(cmd_open_batch)(cmdbuf);
+   panvk_per_arch(cmd_serialize_compute)(cmdbuf);
 
    const struct panvk_shader_desc_info *cs_desc_info =
       &cmdbuf->state.compute.shader->desc_info;
diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index 870ef57..f7b77d1 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -373,7 +373,8 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
       }
 
       /* Barriers recorded after the last batch apply to the next one */
-      queue->serialize_pending |= cmdbuf->state.serialize_next_batch;
+      queue->serialize_pending |= cmdbuf->state.serialize_next_batch ||
+                                  cmdbuf->state.serialize_next_compute;
 
       if (simultaneous) {
          if (!cmdbuf->last_submit &&
diff --git a/src/panfrost/vulkan/panvk_vX_cmd_meta.c b/src/panfrost/vulkan/panvk_vX_cmd_meta.c
index 6fd294a..13cedc7 100644
--- a/src/panfrost/vulkan/panvk_vX_cmd_meta.c
+++ b/src/panfrost/vulkan/panvk_vX_cmd_meta.c
@@ -541,6 +541,9 @@ cmd_fill_mem(struct panvk_cmd_buffer *cmdbuf, uint64_t addr, uint64_t range,
    struct panvk_physical_device *phys_dev =
       to_panvk_physical_device(cmdbuf->vk.base.device->physical);
    const uint32_t max_wg = phys_dev->vk.properties.maxComputeWorkGroupCount[0];
+#if PAN_ARCH < 10
+   panvk_per_arch(cmd_serialize_compute)(cmdbuf);
+#endif
    struct panvk_precomp_ctx ctx = panvk_per_arch(precomp_cs)(cmdbuf);
 
    const bool uint4_path =
@@ -919,6 +922,9 @@ panvk_per_arch(CmdCopyMemoryIndirectKHR)(
    const VkCopyMemoryIndirectInfoKHR *pCopyMemoryIndirectInfo)
 {
    VK_FROM_HANDLE(panvk_cmd_buffer, cmdbuf, commandBuffer);
+#if PAN_ARCH < 10
+   panvk_per_arch(cmd_serialize_compute)(cmdbuf);
+#endif
    struct panvk_precomp_ctx ctx = panvk_per_arch(precomp_cs)(cmdbuf);
 
    for (uint32_t i = 0; i < pCopyMemoryIndirectInfo->copyCount; i++) {
-- 
2.56.0

