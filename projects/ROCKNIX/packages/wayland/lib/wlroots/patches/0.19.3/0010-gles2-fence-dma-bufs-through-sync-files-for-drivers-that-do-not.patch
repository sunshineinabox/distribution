From: sunshineinabox <aqemail@gmail.com>
Date: Mon, 2 Nov 2026 14:00:00 -0800
Subject: [PATCH] gles2: fence DMA-BUFs through sync_files for drivers that do not

Arm's kbase puts no fences on the DMA-BUFs it renders to or reads. With
WLR_GLES2_SYNC_FILES set, wait for the writers of sampled DMA-BUFs and
attach each render pass's fence to the buffers it wrote and read.

diff --git a/include/render/gles2.h b/include/render/gles2.h
index 6b852dc..8d62232 100644
--- a/include/render/gles2.h
+++ b/include/render/gles2.h
@@ -87,6 +87,9 @@ struct wlr_gles2_renderer {
 
 	struct wl_list buffers; // wlr_gles2_buffer.link
 	struct wl_list textures; // wlr_gles2_texture.link
+
+	// The driver does not fence DMA-BUFs itself (WLR_GLES2_SYNC_FILES)
+	bool sync_files;
 };
 
 struct wlr_gles2_render_timer {
@@ -139,6 +142,7 @@ struct wlr_gles2_render_pass {
 	struct wlr_gles2_render_timer *timer;
 	struct wlr_drm_syncobj_timeline *signal_timeline;
 	uint64_t signal_point;
+	struct wl_array sampled; // struct wlr_buffer *, locked
 };
 
 bool is_gles2_pixel_format_supported(const struct wlr_gles2_renderer *renderer,
diff --git a/render/gles2/pass.c b/render/gles2/pass.c
index b10ac04..a378453 100644
--- a/render/gles2/pass.c
+++ b/render/gles2/pass.c
@@ -1,10 +1,12 @@
 #include <stdlib.h>
 #include <assert.h>
 #include <pixman.h>
+#include <poll.h>
 #include <time.h>
 #include <unistd.h>
 #include <wlr/render/drm_syncobj.h>
 #include <wlr/util/transform.h>
+#include "render/dmabuf.h"
 #include "render/egl.h"
 #include "render/gles2.h"
 #include "util/matrix.h"
@@ -19,6 +21,35 @@ static struct wlr_gles2_render_pass *get_render_pass(struct wlr_render_pass *wlr
 	return pass;
 }
 
+// Without implicit sync in the driver, the pass's fence goes on the DMA-BUFs
+// it wrote and read, for the display and the clients to wait on
+static bool fence_pass_buffers(struct wlr_gles2_render_pass *pass) {
+	struct wlr_gles2_renderer *renderer = pass->buffer->renderer;
+	struct wlr_dmabuf_attributes dmabuf;
+
+	EGLSyncKHR sync = wlr_egl_create_sync(renderer->egl, -1);
+	if (sync == EGL_NO_SYNC_KHR) {
+		return false;
+	}
+	glFlush();
+	int sync_file_fd = wlr_egl_dup_fence_fd(renderer->egl, sync);
+	wlr_egl_destroy_sync(renderer->egl, sync);
+	if (sync_file_fd < 0) {
+		return false;
+	}
+
+	bool ok = wlr_buffer_get_dmabuf(pass->buffer->buffer, &dmabuf) &&
+		dmabuf_import_sync_file(dmabuf.fd[0], DMA_BUF_SYNC_WRITE, sync_file_fd);
+	struct wlr_buffer **buffer;
+	wl_array_for_each(buffer, &pass->sampled) {
+		if (wlr_buffer_get_dmabuf(*buffer, &dmabuf)) {
+			dmabuf_import_sync_file(dmabuf.fd[0], DMA_BUF_SYNC_READ, sync_file_fd);
+		}
+	}
+	close(sync_file_fd);
+	return ok;
+}
+
 static bool render_pass_submit(struct wlr_render_pass *wlr_pass) {
 	struct wlr_gles2_render_pass *pass = get_render_pass(wlr_pass);
 	struct wlr_gles2_renderer *renderer = pass->buffer->renderer;
@@ -56,6 +87,10 @@ static bool render_pass_submit(struct wlr_render_pass *wlr_pass) {
 		if (!ok) {
 			goto out;
 		}
+	} else if (renderer->sync_files) {
+		if (!fence_pass_buffers(pass)) {
+			glFinish();
+		}
 	} else {
 		glFlush();
 	}
@@ -69,6 +104,11 @@ out:
 	wlr_egl_restore_context(&pass->prev_ctx);
 
 	wlr_drm_syncobj_timeline_unref(pass->signal_timeline);
+	struct wlr_buffer **sampled;
+	wl_array_for_each(sampled, &pass->sampled) {
+		wlr_buffer_unlock(*sampled);
+	}
+	wl_array_release(&pass->sampled);
 	wlr_buffer_unlock(pass->buffer->buffer);
 	free(pass);
 
@@ -164,6 +204,43 @@ static void setup_blending(enum wlr_render_blend_mode mode) {
 	}
 }
 
+// Wait on the GPU for whoever writes the texture's DMA-BUF, once per pass
+static void sync_sampled_texture(struct wlr_gles2_render_pass *pass,
+		struct wlr_gles2_texture *texture) {
+	struct wlr_gles2_renderer *renderer = pass->buffer->renderer;
+	struct wlr_dmabuf_attributes dmabuf;
+
+	if (texture->buffer == NULL ||
+			!wlr_buffer_get_dmabuf(texture->buffer->buffer, &dmabuf)) {
+		return;
+	}
+	struct wlr_buffer **buffer;
+	wl_array_for_each(buffer, &pass->sampled) {
+		if (*buffer == texture->buffer->buffer) {
+			return;
+		}
+	}
+	buffer = wl_array_add(&pass->sampled, sizeof(*buffer));
+	if (buffer == NULL) {
+		return;
+	}
+	*buffer = wlr_buffer_lock(texture->buffer->buffer);
+
+	int sync_file_fd = dmabuf_export_sync_file(dmabuf.fd[0], DMA_BUF_SYNC_READ);
+	if (sync_file_fd < 0) {
+		return;
+	}
+	struct pollfd pfd = { .fd = sync_file_fd, .events = POLLIN };
+	if (poll(&pfd, 1, 0) == 0) {
+		EGLSyncKHR sync = wlr_egl_create_sync(renderer->egl, sync_file_fd);
+		if (sync != EGL_NO_SYNC_KHR) {
+			wlr_egl_wait_sync(renderer->egl, sync);
+			wlr_egl_destroy_sync(renderer->egl, sync);
+		}
+	}
+	close(sync_file_fd);
+}
+
 static void render_pass_add_texture(struct wlr_render_pass *wlr_pass,
 		const struct wlr_render_texture_options *options) {
 	struct wlr_gles2_render_pass *pass = get_render_pass(wlr_pass);
@@ -221,6 +298,8 @@ static void render_pass_add_texture(struct wlr_render_pass *wlr_pass,
 		if (!ok) {
 			return;
 		}
+	} else if (renderer->sync_files) {
+		sync_sampled_texture(pass, texture);
 	}
 
 	setup_blending(!texture->has_alpha && alpha == 1.0 ?
@@ -322,6 +401,7 @@ struct wlr_gles2_render_pass *begin_gles2_buffer_pass(struct wlr_gles2_buffer *b
 	wlr_render_pass_init(&pass->base, &render_pass_impl);
 	wlr_buffer_lock(wlr_buffer);
 	pass->buffer = buffer;
+	wl_array_init(&pass->sampled);
 	pass->timer = timer;
 	pass->prev_ctx = *prev_ctx;
 	if (signal_timeline != NULL) {
diff --git a/render/gles2/renderer.c b/render/gles2/renderer.c
index bbf2531..4178c80 100644
--- a/render/gles2/renderer.c
+++ b/render/gles2/renderer.c
@@ -15,9 +15,11 @@
 #include <wlr/util/box.h>
 #include <wlr/util/log.h>
 #include <xf86drm.h>
+#include "render/dmabuf.h"
 #include "render/egl.h"
 #include "render/gles2.h"
 #include "render/pixel_format.h"
+#include "util/env.h"
 #include "util/time.h"
 
 #include "common_vert_src.h"
@@ -695,6 +697,10 @@ struct wlr_renderer *wlr_gles2_renderer_create(struct wlr_egl *egl) {
 			egl->procs.eglWaitSyncKHR && cap_syncobj_timeline != 0;
 	}
 
+	renderer->sync_files = env_parse_bool("WLR_GLES2_SYNC_FILES") &&
+		egl->procs.eglDupNativeFenceFDANDROID && egl->procs.eglWaitSyncKHR &&
+		dmabuf_check_sync_file_import_export();
+
 	return &renderer->wlr_renderer;
 
 error:
