+static bool create_ctm_blob(struct wlr_drm_backend *drm,
+		const float matrix[static 9], uint32_t *blob_id) {
+	struct drm_color_ctm ctm = {0};
+
+	for (size_t i = 0; i < 9; i++) {
+		double val = matrix[i];
+		bool negative = val < 0;
+		if (negative) {
+			val = -val;
+		}
+		if (val >= (double)(1ULL << 31)) {
+			wlr_log(WLR_ERROR, "CTM coefficient out of range");
+			return false;
+		}
+
+		ctm.matrix[i] = (uint64_t)(val * (double)(1ULL << 32));
+		if (negative) {
+			ctm.matrix[i] |= 1ULL << 63;
+		}
+	}
+
+	if (drmModeCreatePropertyBlob(drm->fd, &ctm, sizeof(ctm), blob_id) != 0) {
+		wlr_log_errno(WLR_ERROR, "Unable to create CTM property blob");
+		return false;
+	}
+
+	return true;
+}
