 src/config/capability_map/evdev.rs            |  4 +
 src/input/event/evdev.rs                      | 90 +++++++++++++++++++
 src/input/event/evdev/translator.rs           | 29 ++++--
 4 files changed, 123 insertions(+), 5 deletions(-)

