+        auto_center: bool,
+    ) -> InputValue {
+        let mut normal_value = self.get_normalized_value(event, value_type, auto_center);
 
         if inverted {
             normal_value = match value_type {
@@ -494,7 +505,12 @@ impl EventTranslator {
 
     /// Returns the normalized value of the event. This will be a value that
     /// ranges from -1.0 to 1.0 or 0.0 to 1.0 based on the minimum and maximum values.
-    pub fn get_normalized_value(&self, event: &InputEvent, value_type: &ValueType) -> f64 {
+    pub fn get_normalized_value(
+        &self,
+        event: &InputEvent,
+        value_type: &ValueType,
+        auto_center: bool,
+    ) -> f64 {
         let raw_value = event.value();
         if event.event_type() != evdev::EventType::ABSOLUTE {
             return raw_value as f64;
@@ -519,6 +535,9 @@ impl EventTranslator {
                 }
             }
             ValueType::Trigger => normalize_unsigned_value(raw_value, info.minimum(), info.maximum()),
+            ValueType::JoystickX | ValueType::JoystickY if auto_center => {
+                normalize_centered_value(raw_value, info)
+            }
             ValueType::JoystickX | ValueType::JoystickY => {
                 normalize_signed_value(raw_value, info.minimum(), info.maximum())
             }
