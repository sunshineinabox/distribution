&dsi0_in {
	remote-endpoint = <&dither0_out>;
};

&dsi0_out {
	remote-endpoint = <&panel_in>;
};

&mipi_tx0 {
	status = "okay";
};

&pwm0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm0_pins>;
	status = "okay";
};

&pwm1 {
	status = "okay";
};

/* GammaOS tops the GPU at 950 MHz, not mt6785.dtsi's 900 MHz */
&gpu_opp_table {
	/delete-node/ opp-900000000;

	opp-950000000 {
		opp-hz = /bits/ 64 <950000000>;
		opp-microvolt = <875000>;
	};
};

&gpu {
	mali-supply = <&mt6359_vgpu11>;
	status = "okay";
};

&{/soc} {
	/* MT6765 register layout */
	auxadc: adc@11001000 {
		compatible = "mediatek,mt6785-auxadc", "mediatek,mt6765-auxadc";
		reg = <0 0x11001000 0 0x1000>;
		clocks = <&infracfg CLK_INFRA_AUXADC>;
		clock-names = "main";
		#io-channel-cells = <1>;
	};

	efuse@11c10000 {
		compatible = "mediatek,mt6785-efuse", "mediatek,efuse";
		reg = <0 0x11c10000 0 0x1000>;
		#address-cells = <1>;
		#size-cells = <1>;

		/* LVTS calibration: golden temp, count_r0..r7 */
		lvts_e_data1: lvts-golden@1b0 {
			reg = <0x1b0 0x4>;
		};

		lvts_e_data2: lvts-big@1c8 {
			reg = <0x1c8 0x8>;
		};

		/* EEM M_HW_RES0..24 */
		svs_calibration: svs-calib@580 {
			reg = <0x580 0x64>;
		};

		lvts_e_data3: lvts-others@93c {
			reg = <0x93c 0x18>;
		};
	};

	lvts: thermal-sensor@1100b000 {
		compatible = "mediatek,mt6785-lvts";
		reg = <0 0x1100b000 0 0x1000>;
		interrupts = <GIC_SPI 100 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&infracfg CLK_INFRA_THERM>;
		resets = <&infracfg MT6785_INFRA_THERM_CTRL_RST>;
		nvmem-cells = <&lvts_e_data1>, <&lvts_e_data2>, <&lvts_e_data3>;
		nvmem-cell-names = "lvts-calib-data-1", "lvts-calib-data-2",
				   "lvts-calib-data-3";
		#thermal-sensor-cells = <1>;
	};

	/* EEM banks 0xc00 into the thermal block */
	svs: svs@1100bc00 {
		compatible = "mediatek,mt6785-svs";
		reg = <0 0x1100bc00 0 0x400>;
		interrupts = <GIC_SPI 150 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&infracfg CLK_INFRA_THERM>;
		clock-names = "main";
		nvmem-cells = <&svs_calibration>, <&lvts_e_data1>;
		nvmem-cell-names = "svs-calibration-data", "t-calibration-data";
		resets = <&infracfg MT6785_INFRA_SVS_RST>;
		reset-names = "svs_rst";
	};

	/* BTIF + AP DMA: the STP link to CONNSYS for the downstream btif driver */
	btif@1100c000 {
		compatible = "mediatek,btif";
		reg = <0 0x1100c000 0 0x1000>,
		      <0 0x11000b80 0 0x80>,
		      <0 0x11000c00 0 0x80>;
		interrupts = <GIC_SPI 138 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_SPI 155 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_SPI 154 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&infracfg CLK_INFRA_BTIF>, <&infracfg CLK_INFRA_AP_DMA>;
		clock-names = "btifc", "apdmac";
	};

	/* CONNSYS (WMT), register order as mt6785.h *_BASE_INDEX */
	consys@18002000 {
		compatible = "mediatek,mt6785-consys";
		reg = <0 0x18002000 0 0x1000>,
		      <0 0x10007000 0 0x100>,
		      <0 0x10001000 0 0x1000>,
		      <0 0x10006000 0 0x1000>,
		      <0 0x18007000 0 0x1000>,
		      <0 0x180b1000 0 0x1000>,
		      <0 0x180a3000 0 0x1000>,
		      <0 0x180a5000 0 0x800>,
		      <0 0x180c1000 0 0x1000>,
		      <0 0x18004000 0 0x1000>,
		      <0 0x1024c000 0 0x40>,
		      <0 0x10003000 0 0x1000>;
		interrupts = <GIC_SPI 321 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_SPI 78 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_SPI 323 IRQ_TYPE_EDGE_RISING>;
		clocks = <&infracfg CLK_INFRA_CCIF4_AP>;
		clock-names = "ccif";
		memory-region = <&consys_mem>;
		pmic = <&mt6359>;
		vcn18-supply = <&mt6359_vcn18>;
		vcn33_1_wifi-supply = <&mt6359_vcn33_1_wifi>;
		vcn33_2_wifi-supply = <&mt6359_vcn33_2_wifi>;
	};

	wifi@18000000 {
		compatible = "mediatek,wifi";
		reg = <0 0x18000000 0 0x100000>;
		interrupts = <GIC_SPI 322 IRQ_TYPE_LEVEL_LOW>;
		memory-region = <&wifi_mem>;
	};

	/* Vol Down is keypad matrix key 0, pins left as LK set them */
	keypad@10010000 {
		compatible = "mediatek,mt6779-keypad";
		reg = <0 0x10010000 0 0x1000>;
		interrupts = <GIC_SPI 75 IRQ_TYPE_EDGE_FALLING>;
		clocks = <&clk26m>;
		clock-names = "kpd";
		keypad,num-rows = <1>;
		keypad,num-columns = <1>;
		linux,keymap = <MATRIX_KEY(0, 0, KEY_VOLUMEDOWN)>;
	};
};

&i2c0 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	status = "okay";

	/* no axis swap, as stock */
	touchscreen@5a {
		compatible = "hynitron,cst66xx";
		reg = <0x5a>;
		interrupts-extended = <&pio 1 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&pio 2 GPIO_ACTIVE_LOW>;
		vdd-supply = <&mt6360_vtp>;
		touchscreen-size-x = <1280>;
		touchscreen-size-y = <960>;
		pinctrl-names = "default";
		pinctrl-0 = <&touch_pins>;
	};
};

&i2c1 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	status = "okay";

	/* polled, mount-matrix from the stock direction 5 */
	accelerometer@4c {
		compatible = "mcube,mc3416";
		reg = <0x4c>;
		mount-matrix = "0", "1", "0",
			       "1", "0", "0",
			       "0", "0", "-1";
	};
};

/* pins already muxed by LK, which drives the MT6360 itself */
&i2c5 {
	clock-frequency = <400000>;
	status = "okay";

	pmic@34 {
		compatible = "mediatek,mt6360";
		reg = <0x34>;
		interrupts-extended = <&pio 16 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "IRQB";
		interrupt-controller;
		#interrupt-cells = <1>;

		mt6360_adc: adc {
			compatible = "mediatek,mt6360-adc";
			#io-channel-cells = <1>;
		};

		/* PDOs and Rp as stock */
		mt6360_tcpc: tcpc {
			compatible = "mediatek,mt6360-tcpc";
			interrupts-extended = <&pio 7 IRQ_TYPE_LEVEL_LOW>;
			interrupt-names = "PD_IRQB";
			vbus-supply = <&mt6360_otg_vbus>;

			connector {
				compatible = "usb-c-connector";
				label = "USB-C";
				data-role = "dual";
				power-role = "dual";
				try-power-role = "sink";
				typec-power-opmode = "1.5A";
				source-pdos = <PDO_FIXED(5000, 1500, PDO_FIXED_DUAL_ROLE |
							 PDO_FIXED_DATA_SWAP | PDO_FIXED_USB_COMM)>;
				sink-pdos = <PDO_FIXED(5000, 2600, PDO_FIXED_DUAL_ROLE |
						       PDO_FIXED_DATA_SWAP | PDO_FIXED_USB_COMM)>;
				op-sink-microwatt = <13000000>;

				port {
					typec_hs_ep: endpoint {
						remote-endpoint = <&ssusb_hs_ep>;
					};
				};
			};
		};

		/* stock charger settings */
		charger {
			compatible = "mediatek,mt6360-chg";
			/* no Pump Express on mainline: 5 V adapters only */
			richtek,vinovp-microvolt = <6500000>;
			monitored-battery = <&battery>;
			/* Type-C/PD current from TCPM; stock sinks 5 V 2.6 A */
			power-supplies = <&mt6360_tcpc>;
			mediatek,input-current-max-microamp = <2600000>;
			io-channels = <&mt6360_adc 4>, <&mt6360_adc 6>;
			io-channel-names = "vbat", "ibat";
			mediatek,battery-thermal-zone = "battery-thermal";
			mediatek,input-voltage-limit-microvolt = <4400000>;
			mediatek,safety-timer-hours = <12>;
			mediatek,ircomp-resistor-micro-ohms = <25000>;
			mediatek,ircomp-clamp-microvolt = <32000>;

			/* stock OTG boost voltage and current limit */
			mt6360_otg_vbus: usb-otg-vbus-regulator {
				regulator-name = "usb-otg-vbus";
				regulator-min-microvolt = <5050000>;
				regulator-max-microvolt = <5050000>;
				regulator-min-microamp = <500000>;
				regulator-max-microamp = <1800000>;
			};
		};

		regulator {
			compatible = "mediatek,mt6360-regulator";
			/* arm the vendor power-off sequence before power-off (patches/0001) */
			mediatek,poweroff-sequence;

			/* buck2/ldo6/ldo7 feed DRAM and stay undescribed */
			/* VFP: the gamepad's vcc3v3 */
			mt6360_vfp: ldo1 {
				regulator-name = "vfp";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			/* VTP: the touch controller's vtouch, 2.8 V as stock */
			mt6360_vtp: ldo2 {
				regulator-name = "vtp";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};

			mt6360_vmc: ldo3 {
				regulator-name = "vmc";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3000000>;
			};

			mt6360_vmch: ldo5 {
				regulator-name = "vmch";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};
		};
	};
};

/* stock msdc0 caps without hw-reset, 1.8 V I/O from a fixed rail so no vqmmc */
&mmc0 {
	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	non-removable;
	no-sd;
	no-sdio;
	vmmc-supply = <&mt6359_vemc>;

	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins>;
	pinctrl-1 = <&mmc0_pins>;

	status = "okay";
};

/* stock msdc1 caps; card detect GPIO8 reads low with a card and needs no pin state */
&mmc1 {
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	sd-uhs-ddr50;
	disable-wp;
	no-mmc;
	no-sdio;
	cd-gpios = <&pio 8 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&mt6360_vmch>;
	vqmmc-supply = <&mt6360_vmc>;

	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins>;
	pinctrl-1 = <&mmc1_pins>;

	status = "okay";
};

/* the SGM58031 does not answer at 400 kHz on mainline timings */
&i2c6 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins>;
	status = "okay";

	/* AW2023, 1 mA per channel as stock */
	led-controller@45 {
		compatible = "awinic,aw2023";
		reg = <0x45>;
		#address-cells = <1>;
		#size-cells = <0>;

		led@0 {
			reg = <0>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
			led-max-microamp = <1000>;
		};

		led@1 {
			reg = <1>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_INDICATOR;
			led-max-microamp = <1000>;
		};

		led@2 {
			reg = <2>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INDICATOR;
			led-max-microamp = <1000>;
		};
	};

	/* SGM58031 (ADS1115 clone): AIN0 is LT, AIN1 is RT, 4.096 V range */
	trigger_adc: adc@48 {
		compatible = "sgmicro,sgm58031", "ti,ads1115";
		reg = <0x48>;
		vdd-supply = <&gamepad_pwr>;
		#address-cells = <1>;
		#size-cells = <0>;
		#io-channel-cells = <1>;

		channel@4 {
			reg = <4>;
			ti,gain = <1>;
			ti,datarate = <7>;
		};

		channel@5 {
			reg = <5>;
			ti,gain = <1>;
			ti,datarate = <7>;
		};
	};
};

&pio {
	/* MT6359 mtkaif: GPIO with pull-down when idle, as stock */
	aud_clk_mosi_off_pins: aud-clk-mosi-off-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO189__FUNC_GPIO189>,
				 <PINMUX_GPIO190__FUNC_GPIO190>;
			input-enable;
			bias-pull-down;
		};
	};

	aud_clk_mosi_on_pins: aud-clk-mosi-on-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO189__FUNC_AUD_CLK_MOSI>,
				 <PINMUX_GPIO190__FUNC_AUD_SYNC_MOSI>;
			input-schmitt-enable;
			bias-disable;
		};
	};

	aud_dat_mosi_off_pins: aud-dat-mosi-off-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO191__FUNC_GPIO191>,
				 <PINMUX_GPIO192__FUNC_GPIO192>;
			input-enable;
			bias-pull-down;
		};
	};

	aud_dat_mosi_on_pins: aud-dat-mosi-on-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO191__FUNC_AUD_DAT_MOSI0>,
				 <PINMUX_GPIO192__FUNC_AUD_DAT_MOSI1>;
			input-schmitt-enable;
			bias-disable;
		};
	};

	aud_dat_miso_off_pins: aud-dat-miso-off-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO193__FUNC_GPIO193>,
				 <PINMUX_GPIO194__FUNC_GPIO194>;
			input-enable;
			bias-pull-down;
		};
	};

	aud_dat_miso_on_pins: aud-dat-miso-on-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO193__FUNC_AUD_DAT_MISO0>,
				 <PINMUX_GPIO194__FUNC_AUD_DAT_MISO1>;
			input-schmitt-enable;
			bias-disable;
		};
	};

	aud_dat_mosi_ch34_off_pins: aud-dat-mosi-ch34-off-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO143__FUNC_GPIO143>;
			input-enable;
			bias-pull-down;
		};
	};

	aud_dat_mosi_ch34_on_pins: aud-dat-mosi-ch34-on-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO143__FUNC_AUD_DAT_MOSI2>;
			input-schmitt-enable;
			bias-disable;
		};
	};

	aud_dat_miso_ch34_off_pins: aud-dat-miso-ch34-off-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO146__FUNC_GPIO146>;
			input-enable;
			bias-pull-down;
		};
	};

	aud_dat_miso_ch34_on_pins: aud-dat-miso-ch34-on-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO146__FUNC_AUD_DAT_MISO2>;
			input-schmitt-enable;
			bias-disable;
		};
	};

	/* stock pulls */
	gamepad_key_pins: gamepad-key-pins {
		pins-keys {
			pinmux = <PINMUX_GPIO78__FUNC_GPIO78>,
				 <PINMUX_GPIO79__FUNC_GPIO79>,
				 <PINMUX_GPIO80__FUNC_GPIO80>,
				 <PINMUX_GPIO81__FUNC_GPIO81>,
				 <PINMUX_GPIO82__FUNC_GPIO82>,
				 <PINMUX_GPIO83__FUNC_GPIO83>,
				 <PINMUX_GPIO84__FUNC_GPIO84>,
				 <PINMUX_GPIO85__FUNC_GPIO85>,
				 <PINMUX_GPIO86__FUNC_GPIO86>,
				 <PINMUX_GPIO87__FUNC_GPIO87>,
				 <PINMUX_GPIO89__FUNC_GPIO89>,
				 <PINMUX_GPIO90__FUNC_GPIO90>,
				 <PINMUX_GPIO91__FUNC_GPIO91>,
				 <PINMUX_GPIO92__FUNC_GPIO92>,
				 <PINMUX_GPIO93__FUNC_GPIO93>,
				 <PINMUX_GPIO94__FUNC_GPIO94>;
			input-enable;
			bias-pull-up;
		};

		pins-keys-pupd {
			pinmux = <PINMUX_GPIO57__FUNC_GPIO57>,
				 <PINMUX_GPIO58__FUNC_GPIO58>;
			input-enable;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	i2c0_pins: i2c0-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO51__FUNC_SCL0>,
				 <PINMUX_GPIO52__FUNC_SDA0>;
			bias-pull-up;
		};
	};

	i2c1_pins: i2c1-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO61__FUNC_SCL1>,
				 <PINMUX_GPIO62__FUNC_SDA1>;
			bias-pull-up;
		};
	};

	touch_pins: touch-pins {
		pins-irq {
			pinmux = <PINMUX_GPIO1__FUNC_GPIO1>;
			input-enable;
			bias-pull-up;
		};

		pins-reset {
			pinmux = <PINMUX_GPIO2__FUNC_GPIO2>;
			output-high;
		};
	};

	i2c6_pins: i2c6-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO45__FUNC_SCL6>,
				 <PINMUX_GPIO46__FUNC_SDA6>;
			bias-pull-up;
		};
	};

	fan_pins: fan-pins {
		pins-tach {
			pinmux = <PINMUX_GPIO40__FUNC_GPIO40>;
			input-enable;
			bias-pull-up;
		};
	};

	pwm0_pins: pwm0-pins {
		pins-fan {
			pinmux = <PINMUX_GPIO26__FUNC_PWM_0>;
			bias-pull-down;
		};
	};

	stick_led_pins: stick-led-pins {
		pins-data {
			pinmux = <PINMUX_GPIO122__FUNC_PWM_1>,
				 <PINMUX_GPIO124__FUNC_PWM_2>;
			bias-disable;
		};
	};

	/* stock drive strength and pulls */
	mmc1_pins: mmc1-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO135__FUNC_MSDC1_CMD>,
				 <PINMUX_GPIO137__FUNC_MSDC1_DAT0>,
				 <PINMUX_GPIO139__FUNC_MSDC1_DAT1>,
				 <PINMUX_GPIO138__FUNC_MSDC1_DAT2>,
				 <PINMUX_GPIO136__FUNC_MSDC1_DAT3>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_10>;
			drive-strength = <8>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO134__FUNC_MSDC1_CLK>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
			drive-strength = <8>;
		};
	};

	/* stock drive strength and pulls */
	mmc0_pins: mmc0-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO167__FUNC_MSDC0_CMD>,
				 <PINMUX_GPIO168__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO172__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO169__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO177__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO170__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO173__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO171__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO174__FUNC_MSDC0_DAT7>,
				 <PINMUX_GPIO178__FUNC_MSDC0_RSTB>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
			drive-strength = <10>;
		};

		pins-clk-ds {
			pinmux = <PINMUX_GPIO176__FUNC_MSDC0_CLK>,
				 <PINMUX_GPIO175__FUNC_MSDC0_DSL>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
			drive-strength = <10>;
		};
	};
};

/* roles follow the MT6360 Type-C port; VBUS comes from the MT6360 boost */
&ssusb {
	vusb33-supply = <&mt6359_vusb>;
	dr_mode = "otg";
	maximum-speed = "high-speed";
	usb-role-switch;
	role-switch-default-mode = "peripheral";
	status = "okay";

	port {
		ssusb_hs_ep: endpoint {
			remote-endpoint = <&typec_hs_ep>;
		};
	};
};

&xhci {
	status = "okay";
};
