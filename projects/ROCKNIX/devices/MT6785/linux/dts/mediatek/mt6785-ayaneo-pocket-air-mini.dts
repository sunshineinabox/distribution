/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/thermal/mediatek,lvts-thermal.h>
#include <dt-bindings/thermal/thermal.h>

#include "mediatek/mt6785.dtsi"

/ {
	model = "AYANEO Pocket Air Mini";
	compatible = "ayaneo,pocket-air-mini", "mediatek,mt6785";
	chassis-type = "handset";

	/* eMMC probe waits for vemc, so pin the numbering */
	aliases {
		mmc0 = &mmc0;
		mmc1 = &mmc1;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* needed by Little Kernel */
		bootargs = "";

		/* reg, stride and height are patched in by the custom LK (fdt_fixup_simplefb) */
		framebuffer0: framebuffer@7ed90000 {
			compatible = "simple-framebuffer";
			reg = <0 0x7ed90000 0 0x1070000>;
			width = <1280>;
			height = <3366>;
			stride = <(1280 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/*
	 * Must stay empty: LK appends its own mblock-* regions here and spins in
	 * reserved_memory_conflict_check() if any node overlaps one of them.
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
	};

	/* needed by Little Kernel */
	scp {
		compatible = "mediatek,scp";
	};

	/* DISP_PWM (GPIO42), keeping LK's 25.4 kHz */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm1 0 39385>;
		brightness-levels = <0 1023>;
		num-interpolated-steps = <1023>;
		default-brightness-level = <1023>;
	};

	/*
	 * GammaOS: 85 C throttles the CPUs and the GPU, 117 C resets. The VPU
	 * only gets the critical trip.
	 */
	thermal-zones {
		cpu-big0-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&lvts MT6785_BIG_CPU0>;

			trips {
				big0_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <117000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&big0_alert>;
					cooling-device = <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-big1-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&lvts MT6785_BIG_CPU1>;

			trips {
				big1_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <117000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&big1_alert>;
					cooling-device = <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-little0-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&lvts MT6785_LITTLE_CPU0>;

			trips {
				little0_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <117000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&little0_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-little1-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&lvts MT6785_LITTLE_CPU1>;

			trips {
				little1_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <117000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&little1_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-little2-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&lvts MT6785_LITTLE_CPU2>;

			trips {
				little2_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <117000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&little2_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		gpu0-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&lvts MT6785_GPU0>;

			trips {
				gpu0_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <117000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&gpu0_alert>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		gpu1-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&lvts MT6785_GPU1>;

			trips {
				gpu1_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-crit {
					temperature = <117000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&gpu1_alert>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		vpu-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&lvts MT6785_VPU>;

			trips {
				trip-crit {
					temperature = <117000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};
	};
};

/* A55 cluster and CCI share vproc2, the A76 cluster has vproc1 */
&cci {
	proc-supply = <&mt6359_vproc2>;
	sram-supply = <&mt6359_vsram_proc2>;
};

&cpu0 {
	#cooling-cells = <2>;
	proc-supply = <&mt6359_vproc2>;
	sram-supply = <&mt6359_vsram_proc2>;
};

&cpu1 {
	#cooling-cells = <2>;
	proc-supply = <&mt6359_vproc2>;
	sram-supply = <&mt6359_vsram_proc2>;
};

&cpu2 {
	#cooling-cells = <2>;
	proc-supply = <&mt6359_vproc2>;
	sram-supply = <&mt6359_vsram_proc2>;
};

&cpu3 {
	#cooling-cells = <2>;
	proc-supply = <&mt6359_vproc2>;
	sram-supply = <&mt6359_vsram_proc2>;
};

&cpu4 {
	#cooling-cells = <2>;
	proc-supply = <&mt6359_vproc2>;
	sram-supply = <&mt6359_vsram_proc2>;
};

&cpu5 {
	#cooling-cells = <2>;
	proc-supply = <&mt6359_vproc2>;
	sram-supply = <&mt6359_vsram_proc2>;
};

&cpu6 {
	#cooling-cells = <2>;
	proc-supply = <&mt6359_vproc1>;
	sram-supply = <&mt6359_vsram_proc1>;
};

&cpu7 {
	#cooling-cells = <2>;
	proc-supply = <&mt6359_vproc1>;
	sram-supply = <&mt6359_vsram_proc1>;
};

/*
 * No rtc/codec/adc node. Leave power-off-time-sec / long-press-mode out:
 * mainline's MT6359_TOP_RST_MISC (0x14c) is the vendor's TOP_RST_MISC_SET, so
 * the default all-zero update is a no-op and the long-press reset stays as LK
 * set it.
 */
&pwrap {
	pmic {
		compatible = "mediatek,mt6359";
		interrupts-extended = <&pio 193 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <2>;

		/* RTC BBPU + PWRHOLD power-off (patches/0001) */
		power-controller {
			compatible = "mediatek,mt6359-pwrc";
		};

		/* only rails with a consumer, the rest stay undescribed so the kernel leaves them alone */
		regulators {
			/* CPU rails span the mt6785.dtsi OPPs, vsram tracks vproc + 100 mV as stock */
			mt6359_vproc1: buck_vproc1 {
				regulator-name = "vproc1";
				regulator-min-microvolt = <675000>;
				regulator-max-microvolt = <1118750>;
				regulator-ramp-delay = <7500>;
				regulator-always-on;
			};

			mt6359_vproc2: buck_vproc2 {
				regulator-name = "vproc2";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <1031250>;
				regulator-ramp-delay = <7500>;
				regulator-always-on;
			};

			mt6359_vsram_proc1: ldo_vsram_proc1 {
				regulator-name = "vsram_proc1";
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <1118750>;
				regulator-ramp-delay = <7500>;
				regulator-always-on;
			};

			/*
			 * GPU rails as GammaOS uses them (vgpu11 + vpu as vsram_gpu),
			 * spanning the mt6785.dtsi OPPs = the vendor sign-off table.
			 * The MediaTek coupler keeps vsram = max(850 mV, vgpu + 100 mV)
			 * like the vendor gpufreq; both may go off with the MFG domains.
			 */
			mt6359_vgpu11: buck_vgpu11 {
				regulator-name = "vgpu";
				regulator-min-microvolt = <612500>;
				regulator-max-microvolt = <850000>;
				regulator-ramp-delay = <5000>;
				regulator-enable-ramp-delay = <200>;
				regulator-coupled-with = <&mt6359_vpu>;
				regulator-coupled-max-spread = <100000>;
			};

			mt6359_vpu: buck_vpu {
				regulator-name = "vsram_gpu";
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <5000>;
				regulator-enable-ramp-delay = <200>;
				regulator-coupled-with = <&mt6359_vgpu11>;
				regulator-coupled-max-spread = <100000>;
			};

			mt6359_vsram_proc2: ldo_vsram_proc2 {
				regulator-name = "vsram_proc2";
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <1118750>;
				regulator-ramp-delay = <7500>;
				regulator-always-on;
			};

			mt6359_vemc: ldo_vemc {
				regulator-name = "vemc";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-always-on;
			};

			mt6359_vusb: ldo_vusb {
				regulator-name = "vusb";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-always-on;
			};

			mt6359_vio18: ldo_vio18 {
				regulator-name = "vio18";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};
		};

		keys {
			compatible = "mediatek,mt6359-keys";

			power {
				linux,keycodes = <KEY_POWER>;
				wakeup-source;
			};

			home {
				linux,keycodes = <KEY_VOLUMEUP>;
			};
		};
	};
};

/*
 * scpsys powers every domain on at probe and fails as a whole if one does not
 * come up. MD has no modem rails here (power-on times out); audio and
 * connectivity have no users yet. MM and its CAM/ISP/VDEC/VENC subdomains
 * stay: the M4U waits for all of their larbs.
 */
&{/soc/syscon@10006000/power-controller/power-domain@0} {
	status = "disabled";
};

&{/soc/syscon@10006000/power-controller/power-domain@2} {
	status = "disabled";
};

&{/soc/syscon@10006000/power-controller/power-domain@4} {
	status = "disabled";
};

&mfg_async {
	domain-supply = <&mt6359_vgpu11>;
};

/* MFG holds the GPU SRAM */
&mfg {
	domain-supply = <&mt6359_vpu>;
};

/* OVL0 .. DITHER0 -> DSI0 as LK sets it up, panel supplies stay as LK left them */
&dither0_out {
	remote-endpoint = <&dsi0_in>;
};

&dsi0 {
	status = "okay";

	/*
	 * Stock st7703_hd720_lcm_drv: reset GPIO44, 1280x960 sync-pulse video at
	 * the stock 532 Mbps per lane; mt6785-dsi (patches/0002) programs LK's
	 * D-PHY timings and porches, so the link runs LK's 60.05 Hz. The clock
	 * lane must drop to LP between lines (LK's HSTX_CKLP_EN): with a
	 * continuous clock the panel shows only vertical lines. The I lines are
	 * the stock lk_a table byte
	 * for byte (VGH/VGL 0x58, CPUMP 0x32, AVDD 0xE0, AVEE 0x20); the source
	 * LK's default over-drives these. Commands >= 0xB0 go out as generic
	 * writes (gen=), the rest as DCS, as MTK's DSI_set_cmdq_V2 does. Waits
	 * are hex ms.
	 */
	panel@0 {
		compatible = "rocknix,generic-dsi";
		reg = <0>;
		backlight = <&backlight>;
		reset-gpios = <&pio 44 GPIO_ACTIVE_LOW>;

		panel_description =
			"G size=85,64 delays=10,10,120,20,0 format=rgb888 lanes=4 flags=0xc05",
			"M clock=88667 horizontal=1280,60,30,60 vertical=960,16,8,8 default=1",
			"I gen=ee01",
			"I gen=ea07",
			"I gen=eb12",
			"I dcs=05 data=19",
			"I dcs=0a data=86",
			"I dcs=14 data=58",
			"I dcs=15 data=58",
			"I dcs=17 data=32",
			"I dcs=28 data=1f",
			"I dcs=29 data=29",
			"I dcs=2a data=63",
			"I dcs=2f data=f3",
			"I gen=ee02",
			"I dcs=39 data=70",
			"I dcs=00 data=00",
			"I dcs=01 data=0d",
			"I dcs=02 data=14",
			"I dcs=03 data=09",
			"I dcs=04 data=10",
			"I dcs=05 data=4c",
			"I dcs=06 data=0b",
			"I dcs=07 data=11",
			"I dcs=08 data=0e",
			"I dcs=09 data=0d",
			"I dcs=0a data=11",
