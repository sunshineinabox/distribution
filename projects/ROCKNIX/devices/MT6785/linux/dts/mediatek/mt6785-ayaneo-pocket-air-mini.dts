			"I dcs=20 data=00",
			"I dcs=21 data=0b",
			"I dcs=22 data=12",
			"I dcs=23 data=03",
			"I dcs=24 data=08",
			"I dcs=25 data=40",
			"I dcs=26 data=0b",
			"I dcs=27 data=09",
			"I dcs=28 data=0e",
			"I dcs=29 data=0d",
			"I dcs=2a data=11",
			"I dcs=2b data=5f",
			"I dcs=2c data=14",
