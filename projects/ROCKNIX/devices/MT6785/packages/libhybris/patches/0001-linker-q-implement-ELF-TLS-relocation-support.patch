-  size_t loaded_cnt = __libc_shared_globals()->tls_modules.module_count;
-  size_t bytes = dtv_size_in_bytes(MAX(1, loaded_cnt));
-  if (!powerof2(bytes)) {
-    bytes = BIONIC_ROUND_UP_POWER_OF_2(bytes);
-  }
-  return (bytes - sizeof(TlsDtv)) / sizeof(void*);
-}
