-  // Callbacks are supposed to be invoked in the reverse order
-  // in which they were registered.
-  CallbackHolder* node = modules.thread_exit_callback_tail_node;
-  while (node != nullptr) {
-    node->cb();
-    node = node->prev;
-  }
-  modules.first_thread_exit_callback();
-}
