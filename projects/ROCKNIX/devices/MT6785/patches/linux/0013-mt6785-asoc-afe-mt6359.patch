+	return mt6785_rate_transform(afe->dev, rate, dai_id);
+}
+
+static int mt6785_irq_fs(struct snd_pcm_substream *substream, unsigned int rate)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_component *component =
+		snd_soc_rtdcom_lookup(rtd, AFE_PCM_NAME);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(component);
+
+	return mt6785_general_rate_transform(afe->dev, rate);
+}
+
+static int mt6785_get_memif_pbuf_size(struct snd_pcm_substream *substream)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+
+	if ((runtime->period_size * 1000) / runtime->rate > 10)
+		return MT6785_MEMIF_PBUF_SIZE_256_BYTES;
+	else
+		return MT6785_MEMIF_PBUF_SIZE_32_BYTES;
+}
