diff --git a/sound/soc/mediatek/mt6785/mt6785-afe-control.c b/sound/soc/mediatek/mt6785/mt6785-afe-control.c
new file mode 100644
index 000000000..b7cd0e628
--- /dev/null
+++ b/sound/soc/mediatek/mt6785/mt6785-afe-control.c
@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: GPL-2.0
+//
+// MediaTek ALSA SoC Audio Control
+//
+// Based on mt8192-afe-control.c
+//
+// Copyright (c) 2020 MediaTek Inc.
+// Author: Shane Chien <shane.chien@mediatek.com>
+//
+
+#include "mt6785-afe-common.h"
+
+enum {
+	MTK_AFE_RATE_8K = 0,
+	MTK_AFE_RATE_11K = 1,
+	MTK_AFE_RATE_12K = 2,
+	MTK_AFE_RATE_384K = 3,
+	MTK_AFE_RATE_16K = 4,
+	MTK_AFE_RATE_22K = 5,
+	MTK_AFE_RATE_24K = 6,
+	MTK_AFE_RATE_352K = 7,
+	MTK_AFE_RATE_32K = 8,
+	MTK_AFE_RATE_44K = 9,
+	MTK_AFE_RATE_48K = 10,
+	MTK_AFE_RATE_88K = 11,
+	MTK_AFE_RATE_96K = 12,
+	MTK_AFE_RATE_176K = 13,
+	MTK_AFE_RATE_192K = 14,
+	MTK_AFE_RATE_260K = 15,
+};
+
+enum {
+	MTK_AFE_DAI_MEMIF_RATE_8K = 0,
+	MTK_AFE_DAI_MEMIF_RATE_16K = 1,
+	MTK_AFE_DAI_MEMIF_RATE_32K = 2,
+	MTK_AFE_DAI_MEMIF_RATE_48K = 3,
+};
+
+enum {
+	MTK_AFE_PCM_RATE_8K = 0,
+	MTK_AFE_PCM_RATE_16K = 1,
+	MTK_AFE_PCM_RATE_32K = 2,
+	MTK_AFE_PCM_RATE_48K = 3,
+};
+
+unsigned int mt6785_general_rate_transform(struct device *dev,
+					   unsigned int rate)
+{
+	switch (rate) {
+	case 8000:
+		return MTK_AFE_RATE_8K;
+	case 11025:
+		return MTK_AFE_RATE_11K;
+	case 12000:
+		return MTK_AFE_RATE_12K;
+	case 16000:
+		return MTK_AFE_RATE_16K;
+	case 22050:
+		return MTK_AFE_RATE_22K;
+	case 24000:
+		return MTK_AFE_RATE_24K;
+	case 32000:
+		return MTK_AFE_RATE_32K;
+	case 44100:
+		return MTK_AFE_RATE_44K;
+	case 48000:
+		return MTK_AFE_RATE_48K;
+	case 88200:
+		return MTK_AFE_RATE_88K;
+	case 96000:
+		return MTK_AFE_RATE_96K;
+	case 176400:
+		return MTK_AFE_RATE_176K;
+	case 192000:
+		return MTK_AFE_RATE_192K;
+	case 260000:
+		return MTK_AFE_RATE_260K;
+	case 352800:
+		return MTK_AFE_RATE_352K;
+	case 384000:
+		return MTK_AFE_RATE_384K;
+	default:
+		dev_warn(dev, "%s(), rate %u invalid, use %d!!!\n",
+			 __func__,
+			 rate, MTK_AFE_RATE_48K);
+		return MTK_AFE_RATE_48K;
+	}
+}
+
+static unsigned int dai_memif_rate_transform(struct device *dev,
+					     unsigned int rate)
+{
+	switch (rate) {
+	case 8000:
+		return MTK_AFE_DAI_MEMIF_RATE_8K;
+	case 16000:
+		return MTK_AFE_DAI_MEMIF_RATE_16K;
+	case 32000:
+		return MTK_AFE_DAI_MEMIF_RATE_32K;
+	case 48000:
+		return MTK_AFE_DAI_MEMIF_RATE_48K;
+	default:
+		dev_warn(dev, "%s(), rate %u invalid, use %d!!!\n",
+			 __func__,
+			 rate, MTK_AFE_DAI_MEMIF_RATE_16K);
+		return MTK_AFE_DAI_MEMIF_RATE_16K;
+	}
+}
+
+static unsigned int pcm_rate_transform(struct device *dev,
+				       unsigned int rate)
+{
+	switch (rate) {
+	case 8000:
+		return MTK_AFE_PCM_RATE_8K;
+	case 16000:
+		return MTK_AFE_PCM_RATE_16K;
+	case 32000:
+		return MTK_AFE_PCM_RATE_32K;
+	case 48000:
+		return MTK_AFE_PCM_RATE_48K;
+	default:
+		dev_warn(dev, "%s(), rate %u invalid, use %d!!!\n",
+			 __func__,
+			 rate, MTK_AFE_PCM_RATE_32K);
+		return MTK_AFE_PCM_RATE_32K;
+	}
+}
+
+unsigned int mt6785_rate_transform(struct device *dev,
+				   unsigned int rate, int aud_blk)
+{
+	switch (aud_blk) {
+	case MT6785_MEMIF_DAI:
+	case MT6785_MEMIF_MOD_DAI:
+		return dai_memif_rate_transform(dev, rate);
+	case MT6785_DAI_PCM_1:
+	case MT6785_DAI_PCM_2:
+		return pcm_rate_transform(dev, rate);
+	default:
+		return mt6785_general_rate_transform(dev, rate);
+	}
+}
+
+int mt6785_dai_set_priv(struct mtk_base_afe *afe, int id,
+			int priv_size, const void *priv_data)
+{
+	struct mt6785_afe_private *afe_priv = afe->platform_priv;
+	void *temp_data;
+
+	temp_data = devm_kzalloc(afe->dev,
+				 priv_size,
+				 GFP_KERNEL);
+	if (!temp_data)
+		return -ENOMEM;
+
+	if (priv_data)
+		memcpy(temp_data, priv_data, priv_size);
+
+	afe_priv->dai_priv[id] = temp_data;
+
+	return 0;
+}
diff --git a/sound/soc/mediatek/mt6785/mt6785-afe-gpio.c b/sound/soc/mediatek/mt6785/mt6785-afe-gpio.c
new file mode 100644
index 000000000..3f5f43548
--- /dev/null
+++ b/sound/soc/mediatek/mt6785/mt6785-afe-gpio.c
@@ -0,0 +1,269 @@
+// SPDX-License-Identifier: GPL-2.0
+//
+// mt6785-afe-gpio.c  --  Mediatek 6785 afe gpio ctrl
+//
+// Based on mt8192-afe-gpio.c
+//
+// Copyright (c) 2020 MediaTek Inc.
+// Author: Shane Chien <shane.chien@mediatek.com>
+//
+
+#include <linux/pinctrl/consumer.h>
+
+#include "mt6785-afe-common.h"
+#include "mt6785-afe-gpio.h"
+
+static struct pinctrl *aud_pinctrl;
+
+enum mt6785_afe_gpio {
+	MT6785_AFE_GPIO_DAT_MISO_OFF,
+	MT6785_AFE_GPIO_DAT_MISO_ON,
+	MT6785_AFE_GPIO_DAT_MOSI_OFF,
+	MT6785_AFE_GPIO_DAT_MOSI_ON,
+	MT6785_AFE_GPIO_DAT_MISO_CH34_OFF,
+	MT6785_AFE_GPIO_DAT_MISO_CH34_ON,
+	MT6785_AFE_GPIO_DAT_MOSI_CH34_OFF,
+	MT6785_AFE_GPIO_DAT_MOSI_CH34_ON,
+	MT6785_AFE_GPIO_I2S0_OFF,
+	MT6785_AFE_GPIO_I2S0_ON,
+	MT6785_AFE_GPIO_I2S1_OFF,
+	MT6785_AFE_GPIO_I2S1_ON,
+	MT6785_AFE_GPIO_I2S2_OFF,
+	MT6785_AFE_GPIO_I2S2_ON,
+	MT6785_AFE_GPIO_I2S3_OFF,
+	MT6785_AFE_GPIO_I2S3_ON,
+	MT6785_AFE_GPIO_I2S5_OFF,
+	MT6785_AFE_GPIO_I2S5_ON,
+	MT6785_AFE_GPIO_VOW_DAT_OFF,
+	MT6785_AFE_GPIO_VOW_DAT_ON,
+	MT6785_AFE_GPIO_VOW_CLK_OFF,
+	MT6785_AFE_GPIO_VOW_CLK_ON,
+	MT6785_AFE_GPIO_CLK_MOSI_OFF,
+	MT6785_AFE_GPIO_CLK_MOSI_ON,
+	MT6785_AFE_GPIO_TDM_OFF,
+	MT6785_AFE_GPIO_TDM_ON,
+	MT6785_AFE_GPIO_GPIO_NUM
+};
+
+struct audio_gpio_attr {
+	const char *name;
+	bool gpio_prepare;
+	struct pinctrl_state *gpioctrl;
+};
+
+static struct audio_gpio_attr aud_gpios[MT6785_AFE_GPIO_GPIO_NUM] = {
+	[MT6785_AFE_GPIO_DAT_MISO_OFF] = {"aud_dat_miso_off", false, NULL},
+	[MT6785_AFE_GPIO_DAT_MISO_ON] = {"aud_dat_miso_on", false, NULL},
+	[MT6785_AFE_GPIO_DAT_MOSI_OFF] = {"aud_dat_mosi_off", false, NULL},
+	[MT6785_AFE_GPIO_DAT_MOSI_ON] = {"aud_dat_mosi_on", false, NULL},
+	[MT6785_AFE_GPIO_I2S0_OFF] = {"aud_gpio_i2s0_off", false, NULL},
+	[MT6785_AFE_GPIO_I2S0_ON] = {"aud_gpio_i2s0_on", false, NULL},
+	[MT6785_AFE_GPIO_I2S1_OFF] = {"aud_gpio_i2s1_off", false, NULL},
+	[MT6785_AFE_GPIO_I2S1_ON] = {"aud_gpio_i2s1_on", false, NULL},
+	[MT6785_AFE_GPIO_I2S2_OFF] = {"aud_gpio_i2s2_off", false, NULL},
+	[MT6785_AFE_GPIO_I2S2_ON] = {"aud_gpio_i2s2_on", false, NULL},
+	[MT6785_AFE_GPIO_I2S3_OFF] = {"aud_gpio_i2s3_off", false, NULL},
+	[MT6785_AFE_GPIO_I2S3_ON] = {"aud_gpio_i2s3_on", false, NULL},
+	[MT6785_AFE_GPIO_I2S5_OFF] = {"aud_gpio_i2s5_off", false, NULL},
+	[MT6785_AFE_GPIO_I2S5_ON] = {"aud_gpio_i2s5_on", false, NULL},
+	[MT6785_AFE_GPIO_TDM_OFF] = {"aud_gpio_tdm_off", false, NULL},
+	[MT6785_AFE_GPIO_TDM_ON] = {"aud_gpio_tdm_on", false, NULL},
+	[MT6785_AFE_GPIO_VOW_DAT_OFF] = {"vow_dat_miso_off", false, NULL},
+	[MT6785_AFE_GPIO_VOW_DAT_ON] = {"vow_dat_miso_on", false, NULL},
+	[MT6785_AFE_GPIO_VOW_CLK_OFF] = {"vow_clk_miso_off", false, NULL},
+	[MT6785_AFE_GPIO_VOW_CLK_ON] = {"vow_clk_miso_on", false, NULL},
+	[MT6785_AFE_GPIO_DAT_MISO_CH34_OFF] = {"aud_dat_miso_ch34_off",
+					       false, NULL},
+	[MT6785_AFE_GPIO_DAT_MISO_CH34_ON] = {"aud_dat_miso_ch34_on",
+					      false, NULL},
+	[MT6785_AFE_GPIO_DAT_MOSI_CH34_OFF] = {"aud_dat_mosi_ch34_off",
+					       false, NULL},
+	[MT6785_AFE_GPIO_DAT_MOSI_CH34_ON] = {"aud_dat_mosi_ch34_on",
+					      false, NULL},
+	[MT6785_AFE_GPIO_CLK_MOSI_OFF] = {"aud_clk_mosi_off", false, NULL},
+	[MT6785_AFE_GPIO_CLK_MOSI_ON] = {"aud_clk_mosi_on", false, NULL},
+};
+
+static DEFINE_MUTEX(gpio_request_mutex);
+
+static int mt6785_afe_gpio_select(struct device *dev,
+				  enum mt6785_afe_gpio type)
+{
+	int ret;
+
+	if (type < 0 || type >= MT6785_AFE_GPIO_GPIO_NUM) {
+		dev_err(dev, "%s(), error, invalid gpio type %d\n",
+			__func__, type);
+		return -EINVAL;
+	}
+
+	if (!aud_gpios[type].gpio_prepare) {
+		dev_warn(dev, "%s(), error, gpio type %d not prepared\n",
+			 __func__, type);
+		return -EIO;
+	}
+
+	ret = pinctrl_select_state(aud_pinctrl,
+				   aud_gpios[type].gpioctrl);
+	if (ret) {
+		dev_dbg(dev, "%s(), error, can not set gpio type %d\n",
+			__func__, type);
+	}
+
+	return ret;
+}
+
+int mt6785_afe_gpio_init(struct device *dev)
+{
+	int i, ret;
+
+	aud_pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(aud_pinctrl)) {
+		ret = PTR_ERR(aud_pinctrl);
+		dev_err(dev, "%s(), ret %d, cannot get aud_pinctrl!\n",
+			__func__, ret);
+		return ret;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(aud_gpios); i++) {
+		aud_gpios[i].gpioctrl = pinctrl_lookup_state(aud_pinctrl,
+							     aud_gpios[i].name);
+		if (IS_ERR(aud_gpios[i].gpioctrl)) {
+			ret = PTR_ERR(aud_gpios[i].gpioctrl);
+			dev_dbg(dev, "%s(), pinctrl_lookup_state %s fail, ret %d\n",
+				__func__, aud_gpios[i].name, ret);
+		} else {
+			aud_gpios[i].gpio_prepare = true;
+		}
+	}
+
+	mt6785_afe_gpio_select(dev, MT6785_AFE_GPIO_CLK_MOSI_ON);
+
+	/* gpio status init */
+	mt6785_afe_gpio_request(dev, false, MT6785_DAI_ADDA, 0);
+	mt6785_afe_gpio_request(dev, false, MT6785_DAI_ADDA, 1);
+
+	return 0;
+}
+EXPORT_SYMBOL(mt6785_afe_gpio_init);
+
+static int mt6785_afe_gpio_adda_dl(struct device *dev, bool enable)
+{
+	if (enable) {
+		return mt6785_afe_gpio_select(dev,
+					      MT6785_AFE_GPIO_DAT_MOSI_ON);
+	} else {
+		return mt6785_afe_gpio_select(dev,
+					      MT6785_AFE_GPIO_DAT_MOSI_OFF);
+	}
+}
+
+static int mt6785_afe_gpio_adda_ul(struct device *dev, bool enable)
+{
+	if (enable) {
+		return mt6785_afe_gpio_select(dev,
+					      MT6785_AFE_GPIO_DAT_MISO_ON);
+	} else {
+		return mt6785_afe_gpio_select(dev,
+					      MT6785_AFE_GPIO_DAT_MISO_OFF);
+	}
+}
+
+static int mt6785_afe_gpio_adda_ch34_dl(struct device *dev, bool enable)
+{
+	if (enable) {
+		return mt6785_afe_gpio_select(dev,
+			MT6785_AFE_GPIO_DAT_MOSI_CH34_ON);
+	} else {
+		return mt6785_afe_gpio_select(dev,
+			MT6785_AFE_GPIO_DAT_MOSI_CH34_OFF);
+	}
+}
+
+static int mt6785_afe_gpio_adda_ch34_ul(struct device *dev, bool enable)
+{
+	if (enable) {
+		return mt6785_afe_gpio_select(dev,
+			MT6785_AFE_GPIO_DAT_MISO_CH34_ON);
+	} else {
+		return mt6785_afe_gpio_select(dev,
+			MT6785_AFE_GPIO_DAT_MISO_CH34_OFF);
+	}
+}
+
+int mt6785_afe_gpio_request(struct device *dev, bool enable,
+			    int dai, int uplink)
+{
+	mutex_lock(&gpio_request_mutex);
+	switch (dai) {
+	case MT6785_DAI_ADDA:
+		if (uplink)
+			mt6785_afe_gpio_adda_ul(dev, enable);
+		else
+			mt6785_afe_gpio_adda_dl(dev, enable);
+		break;
+	case MT6785_DAI_ADDA_CH34:
+		if (uplink)
+			mt6785_afe_gpio_adda_ch34_ul(dev, enable);
+		else
+			mt6785_afe_gpio_adda_ch34_dl(dev, enable);
+		break;
+	case MT6785_DAI_I2S_0:
+		if (enable)
+			mt6785_afe_gpio_select(dev, MT6785_AFE_GPIO_I2S0_ON);
+		else
+			mt6785_afe_gpio_select(dev, MT6785_AFE_GPIO_I2S0_OFF);
+		break;
+	case MT6785_DAI_I2S_1:
+		if (enable)
+			mt6785_afe_gpio_select(dev, MT6785_AFE_GPIO_I2S1_ON);
+		else
+			mt6785_afe_gpio_select(dev, MT6785_AFE_GPIO_I2S1_OFF);
+		break;
+	case MT6785_DAI_I2S_2:
+		if (enable)
+			mt6785_afe_gpio_select(dev, MT6785_AFE_GPIO_I2S2_ON);
+		else
+			mt6785_afe_gpio_select(dev, MT6785_AFE_GPIO_I2S2_OFF);
+		break;
+	case MT6785_DAI_I2S_3:
+		if (enable)
+			mt6785_afe_gpio_select(dev, MT6785_AFE_GPIO_I2S3_ON);
+		else
+			mt6785_afe_gpio_select(dev, MT6785_AFE_GPIO_I2S3_OFF);
+		break;
+	case MT6785_DAI_I2S_5:
+		if (enable)
+			mt6785_afe_gpio_select(dev, MT6785_AFE_GPIO_I2S5_ON);
+		else
+			mt6785_afe_gpio_select(dev, MT6785_AFE_GPIO_I2S5_OFF);
+		break;
+	case MT6785_DAI_TDM:
+		if (enable)
+			mt6785_afe_gpio_select(dev, MT6785_AFE_GPIO_TDM_ON);
+		else
+			mt6785_afe_gpio_select(dev, MT6785_AFE_GPIO_TDM_OFF);
+		break;
+	case MT6785_DAI_VOW:
+		if (enable) {
+			mt6785_afe_gpio_select(dev,
+					       MT6785_AFE_GPIO_VOW_CLK_ON);
+			mt6785_afe_gpio_select(dev,
+					       MT6785_AFE_GPIO_VOW_DAT_ON);
+		} else {
+			mt6785_afe_gpio_select(dev,
+					       MT6785_AFE_GPIO_VOW_CLK_OFF);
+			mt6785_afe_gpio_select(dev,
+					       MT6785_AFE_GPIO_VOW_DAT_OFF);
+		}
+		break;
+	default:
+		mutex_unlock(&gpio_request_mutex);
+		dev_warn(dev, "%s(), invalid dai %d\n", __func__, dai);
+		return -EINVAL;
+	}
+	mutex_unlock(&gpio_request_mutex);
+
+	return 0;
+}
+EXPORT_SYMBOL(mt6785_afe_gpio_request);
