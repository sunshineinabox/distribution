+static int mt6785_mt6359_soc_card_probe(struct mtk_soc_card_data *soc_card_data, bool legacy)
+{
+	struct snd_soc_card *card = soc_card_data->card_data->card;
+	int ret;
+
+	if (legacy)
+		return dev_err_probe(card->dev, -EINVAL, "audio-routing is required\n");
+
+	ret = snd_soc_of_parse_aux_devs(card, "aux-devs");
+	if (ret)
+		return dev_err_probe(card->dev, ret, "failed to parse aux-devs\n");
+
+	ret = mt6785_afe_gpio_init(card->dev);
+	if (ret)
+		return dev_err_probe(card->dev, ret, "%s init gpio error\n", __func__);
+
+	return 0;
+}
