From: sunshineinabox <aqemail@gmail.com>
Date: Thu, 30 Oct 2026 19:15:00 +0000
Subject: [PATCH] power: supply: mt6360_charger: apply the battery limits

The driver never programs charge voltage, current or termination, so the
charger keeps whatever the bootloader left, and the BC1.2 result is only
reported. With a monitored-battery:

- set CV, termination and precharge from the battery, and MIVR, the
  safety timer and IR compensation from the charger node
- after BC1.2 limit input and charge current to 500 mA (SDP and unknown),
  1.5 A (CDP) or 2.5 A (DCP), capped at the battery maximum
- poll the battery thermal zone, stop charging outside the battery
  operating range (resume 3 C above / 2 C below) and stay at 500 mA while
  the temperature is unknown
- register a battery supply: MT6360 ADC voltage and charge current,
  capacity from the OCV table, temperature from the thermal zone

Also write MIVR to CTRL6: set_mivr wrote the AICR register.
---
diff --git a/drivers/power/supply/mt6360_charger.c b/drivers/power/supply/mt6360_charger.c
index 77747eb51..1aaa13f9c 100644
--- a/drivers/power/supply/mt6360_charger.c
+++ b/drivers/power/supply/mt6360_charger.c
@@ -4,6 +4,7 @@
  */
 
 #include <linux/devm-helpers.h>
+#include <linux/iio/consumer.h>
 #include <linux/init.h>
 #include <linux/interrupt.h>
 #include <linux/kernel.h>
@@ -15,6 +16,7 @@
 #include <linux/property.h>
 #include <linux/regmap.h>
 #include <linux/regulator/driver.h>
+#include <linux/thermal.h>
 
 #define MT6360_PMU_CHG_CTRL1	0x311
 #define MT6360_PMU_CHG_CTRL2	0x312
@@ -26,6 +28,8 @@
 #define MT6360_PMU_CHG_CTRL8	0x318
 #define MT6360_PMU_CHG_CTRL9	0x319
 #define MT6360_PMU_CHG_CTRL10	0x31A
+#define MT6360_PMU_CHG_CTRL12	0x31C
+#define MT6360_PMU_CHG_CTRL18	0x32C
 #define MT6360_PMU_DEVICE_TYPE	0x322
 #define MT6360_PMU_USB_STATUS1	0x327
 #define MT6360_PMU_CHG_STAT	0x34A
@@ -40,6 +44,15 @@
 /* MT6360_PMU_CHG_CTRL2 */
 #define MT6360_IINLMTSEL_SHFT	(2)
 #define MT6360_IINLMTSEL_MASK	GENMASK(3, 2)
+#define MT6360_CHG_EN_MASK	BIT(0)
+/* MT6360_PMU_CHG_CTRL12 */
+#define MT6360_WT_FC_SHFT	(5)
+#define MT6360_WT_FC_MASK	GENMASK(7, 5)
+#define MT6360_TMR_EN_MASK	BIT(1)
+/* MT6360_PMU_CHG_CTRL18 */
+#define MT6360_BAT_COMP_SHFT	(3)
+#define MT6360_BAT_COMP_MASK	GENMASK(5, 3)
+#define MT6360_VCLAMP_MASK	GENMASK(2, 0)
 /* MT6360_PMU_CHG_CTRL3 */
 #define MT6360_IAICR_SHFT	(2)
 #define MT6360_IAICR_MASK	GENMASK(7, 2)
@@ -134,6 +147,20 @@ struct mt6360_chg_info {
 	bool bc12_en;
 	int psy_usb_type;
 	struct work_struct chrdet_work;
+	struct power_supply_battery_info *bat_info;
+	struct power_supply_desc bat_desc;
+	struct power_supply *bat_psy;
+	struct iio_channel *vbat_chan;
+	struct iio_channel *ibat_chan;
+	const char *bat_tz_name;
+	struct thermal_zone_device *bat_tz;
+	struct delayed_work bat_work;
+	u32 ichg_max;
+	u32 limit_ua;
+	bool temp_ok;
+	bool temp_block;
+	int bat_temp;
+	int bat_cap;
 };
 
 enum mt6360_iinlmtsel {
@@ -414,7 +441,7 @@ static int mt6360_charger_set_mivr(struct mt6360_chg_info *mci,
 
 	linear_range_get_selector_within(&mt6360_chg_range[MT6360_RANGE_VMIVR], val->intval, &sel);
 	return regmap_update_bits(mci->regmap,
-				  MT6360_PMU_CHG_CTRL3,
+				  MT6360_PMU_CHG_CTRL6,
 				  MT6360_VMIVR_MASK,
 				  sel << MT6360_VMIVR_SHFT);
 }
@@ -443,6 +470,303 @@ static int mt6360_charger_set_ieoc(struct mt6360_chg_info *mci,
 				  sel << MT6360_IEOC_SHFT);
 }
 
+/* Port limits from the stock charger policy */
+static u32 mt6360_chg_port_limit(int usb_type)
+{
+	switch (usb_type) {
+	case POWER_SUPPLY_USB_TYPE_CDP:
+		return 1500000;
+	case POWER_SUPPLY_USB_TYPE_DCP:
+		return 2500000;
+	default:
+		return 500000;
+	}
+}
+
+/* Called with chgdet_lock held */
+static void mt6360_chg_apply_limits(struct mt6360_chg_info *mci)
+{
+	union power_supply_propval val;
+	u32 limit;
+
+	if (!mci->bat_info)
+		return;
+
+	limit = mt6360_chg_port_limit(mci->psy_usb_type);
+	/* Stay at USB current while the battery temperature is unknown */
+	if (!mci->temp_ok)
+		limit = min(limit, 500000U);
+
+	if (limit == mci->limit_ua)
+		return;
+	mci->limit_ua = limit;
+
+	val.intval = limit;
+	mt6360_charger_set_aicr(mci, &val);
+	val.intval = min(limit, mci->ichg_max);
+	mt6360_charger_set_ichg(mci, &val);
+	dev_info(mci->dev, "usb type %d: input %u mA, charge %u mA\n",
+		 mci->psy_usb_type, limit / 1000, val.intval / 1000);
+}
+
+/* Stock hysteresis before charging resumes */
+#define MT6360_TEMP_RESUME_LOW	3000
+#define MT6360_TEMP_RESUME_HIGH	2000
+#define MT6360_BAT_POLL_MS	10000
+
+static void mt6360_bat_update_capacity(struct mt6360_chg_info *mci, int status)
+{
+	struct power_supply_battery_info *info = mci->bat_info;
+	int vbat, ibat = 0, ocv, cap;
+
+	if (!mci->vbat_chan || info->ocv_table_size[0] <= 0)
+		return;
+	if (status == POWER_SUPPLY_STATUS_FULL) {
+		mci->bat_cap = 100;
+		return;
+	}
+	if (iio_read_channel_processed(mci->vbat_chan, &vbat) < 0)
+		return;
+	if (mci->ibat_chan && iio_read_channel_processed(mci->ibat_chan, &ibat) < 0)
+		ibat = 0;
+
+	/* uV and uA from the ADC, minus the charge current's IR drop */
+	ocv = vbat;
+	if (info->factory_internal_resistance_uohm > 0)
+		ocv -= div_s64((s64)ibat * info->factory_internal_resistance_uohm, 1000000);
+	cap = power_supply_batinfo_ocv2cap(info, ocv, 25);
+	if (cap < 0)
+		return;
+
+	/* One step per poll, and only in the direction the battery is going */
+	if (mci->bat_cap < 0)
+		mci->bat_cap = cap;
+	else if (status == POWER_SUPPLY_STATUS_CHARGING && cap > mci->bat_cap)
+		mci->bat_cap++;
+	else if (status == POWER_SUPPLY_STATUS_DISCHARGING && cap < mci->bat_cap)
+		mci->bat_cap--;
+}
+
+static void mt6360_bat_work(struct work_struct *work)
+{
+	struct mt6360_chg_info *mci = container_of(to_delayed_work(work),
+						   struct mt6360_chg_info, bat_work);
+	struct power_supply_battery_info *info = mci->bat_info;
+	union power_supply_propval status = { .intval = POWER_SUPPLY_STATUS_UNKNOWN };
+	struct thermal_zone_device *tz;
+	int temp = 0, ret = -ENODEV, old_cap = mci->bat_cap;
+	bool ok, block = mci->temp_block, changed = false;
+
+	if (!mci->bat_tz && mci->bat_tz_name) {
+		tz = thermal_zone_get_zone_by_name(mci->bat_tz_name);
+		if (!IS_ERR(tz))
+			mci->bat_tz = tz;
+	}
+	if (mci->bat_tz)
+		ret = thermal_zone_get_temp(mci->bat_tz, &temp);
+
+	/* Outside -30..100 C the NTC is open or shorted */
+	ok = !ret && temp > -30000 && temp < 100000;
+	if (ok && info->temp_min != INT_MIN && info->temp_max != INT_MAX) {
+		if (temp < info->temp_min * 1000 || temp > info->temp_max * 1000)
+			block = true;
+		else if (temp >= info->temp_min * 1000 + MT6360_TEMP_RESUME_LOW &&
+			 temp <= info->temp_max * 1000 - MT6360_TEMP_RESUME_HIGH)
+			block = false;
+	}
+
+	mutex_lock(&mci->chgdet_lock);
+	if (block != mci->temp_block) {
+		regmap_update_bits(mci->regmap, MT6360_PMU_CHG_CTRL2,
+				   MT6360_CHG_EN_MASK, block ? 0 : MT6360_CHG_EN_MASK);
+		dev_info(mci->dev, "battery at %d mC, charging %s\n", temp,
+			 block ? "stopped" : "resumed");
+		mci->temp_block = block;
+		changed = true;
+	}
+	if (ok != mci->temp_ok) {
+		mci->temp_ok = ok;
+		if (!ok)
+			dev_warn(mci->dev, "battery temperature unknown, limiting to 500 mA\n");
+		mt6360_chg_apply_limits(mci);
+		changed = true;
+	}
+	mutex_unlock(&mci->chgdet_lock);
+	if (ok)
+		mci->bat_temp = temp;
+
+	mt6360_charger_get_status(mci, &status);
+	mt6360_bat_update_capacity(mci, status.intval);
+	if (mci->bat_psy && (changed || old_cap != mci->bat_cap))
+		power_supply_changed(mci->bat_psy);
+
+	schedule_delayed_work(&mci->bat_work, msecs_to_jiffies(MT6360_BAT_POLL_MS));
+}
+
+static const enum power_supply_property mt6360_bat_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+};
+
+static int mt6360_bat_get_property(struct power_supply *psy,
+				   enum power_supply_property psp,
+				   union power_supply_propval *val)
+{
+	struct mt6360_chg_info *mci = power_supply_get_drvdata(psy);
+	int ret;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		return mt6360_charger_get_status(mci, val);
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		return 0;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		ret = iio_read_channel_processed(mci->vbat_chan, &val->intval);
+		return ret < 0 ? ret : 0;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		if (!mci->ibat_chan)
+			return -ENODATA;
+		ret = iio_read_channel_processed(mci->ibat_chan, &val->intval);
+		return ret < 0 ? ret : 0;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		if (mci->bat_cap < 0)
+			return -ENODATA;
+		val->intval = mci->bat_cap;
+		return 0;
+	case POWER_SUPPLY_PROP_TEMP:
+		if (!mci->temp_ok)
+			return -ENODATA;
+		val->intval = mci->bat_temp / 100;
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		if (mci->bat_info->charge_full_design_uah <= 0)
+			return -ENODATA;
+		val->intval = mci->bat_info->charge_full_design_uah;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int mt6360_bat_init(struct mt6360_chg_info *mci)
+{
+	static const u32 timer_hours[] = { 4, 6, 8, 10, 12, 14, 16, 20 };
+	struct power_supply_battery_info *info;
+	struct power_supply_config bat_cfg = {};
+	struct device *dev = mci->dev;
+	union power_supply_propval val;
+	u32 prop, vclamp = 0, sel;
+	int ret;
+
+	mci->bat_cap = -1;
+	/* Without a monitored battery leave the charger as the bootloader set it */
+	if (power_supply_get_battery_info(mci->psy, &mci->bat_info)) {
+		mci->bat_info = NULL;
+		return 0;
+	}
+	info = mci->bat_info;
+
+	mci->ichg_max = info->constant_charge_current_max_ua > 0 ?
+			info->constant_charge_current_max_ua : 500000;
+	if (info->constant_charge_voltage_max_uv > 0) {
+		val.intval = info->constant_charge_voltage_max_uv;
+		ret = mt6360_charger_set_cv(mci, &val);
+		if (ret)
+			return dev_err_probe(dev, ret, "Failed to set cv\n");
+	}
+	if (info->charge_term_current_ua > 0) {
+		val.intval = info->charge_term_current_ua;
+		ret = mt6360_charger_set_ieoc(mci, &val);
+		if (ret)
+			return dev_err_probe(dev, ret, "Failed to set ieoc\n");
+	}
+	if (info->precharge_current_ua > 0) {
+		val.intval = info->precharge_current_ua;
+		ret = mt6360_charger_set_iprechg(mci, &val);
+		if (ret)
+			return dev_err_probe(dev, ret, "Failed to set iprechg\n");
+	}
+	if (!device_property_read_u32(dev, "mediatek,input-voltage-limit-microvolt", &prop)) {
+		val.intval = prop;
+		ret = mt6360_charger_set_mivr(mci, &val);
+		if (ret)
+			return dev_err_probe(dev, ret, "Failed to set mivr\n");
+	}
+	if (!device_property_read_u32(dev, "mediatek,safety-timer-hours", &prop)) {
+		for (sel = 0; sel < ARRAY_SIZE(timer_hours); sel++)
+			if (timer_hours[sel] == prop)
+				break;
+		if (sel == ARRAY_SIZE(timer_hours))
+			return dev_err_probe(dev, -EINVAL, "Unsupported safety timer %u h\n", prop);
+		ret = regmap_update_bits(mci->regmap, MT6360_PMU_CHG_CTRL12,
+					 MT6360_WT_FC_MASK | MT6360_TMR_EN_MASK,
+					 sel << MT6360_WT_FC_SHFT | MT6360_TMR_EN_MASK);
+		if (ret)
+			return dev_err_probe(dev, ret, "Failed to set safety timer\n");
+	}
+	if (!device_property_read_u32(dev, "mediatek,ircomp-resistor-micro-ohms", &prop)) {
+		device_property_read_u32(dev, "mediatek,ircomp-clamp-microvolt", &vclamp);
+		ret = regmap_update_bits(mci->regmap, MT6360_PMU_CHG_CTRL18,
+					 MT6360_BAT_COMP_MASK | MT6360_VCLAMP_MASK,
+					 min(prop / 25000, 7U) << MT6360_BAT_COMP_SHFT |
+					 min(vclamp / 32000, 7U));
+		if (ret)
+			return dev_err_probe(dev, ret, "Failed to set ir compensation\n");
+	}
+
+	/* 500 mA until the battery temperature has been read */
+	mutex_lock(&mci->chgdet_lock);
+	mt6360_chg_apply_limits(mci);
+	mutex_unlock(&mci->chgdet_lock);
+
+	device_property_read_string(dev, "mediatek,battery-thermal-zone", &mci->bat_tz_name);
+
+	mci->vbat_chan = devm_iio_channel_get(dev, "vbat");
+	if (IS_ERR(mci->vbat_chan)) {
+		ret = PTR_ERR(mci->vbat_chan);
+		mci->vbat_chan = NULL;
+		if (ret != -ENODEV)
+			return dev_err_probe(dev, ret, "Failed to get vbat channel\n");
+	}
+	mci->ibat_chan = devm_iio_channel_get(dev, "ibat");
+	if (IS_ERR(mci->ibat_chan)) {
+		ret = PTR_ERR(mci->ibat_chan);
+		mci->ibat_chan = NULL;
+		if (ret != -ENODEV)
+			return dev_err_probe(dev, ret, "Failed to get ibat channel\n");
+	}
+
+	ret = devm_delayed_work_autocancel(dev, &mci->bat_work, mt6360_bat_work);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to init battery work\n");
+
+	if (mci->vbat_chan) {
+		mci->bat_desc.name = "battery";
+		mci->bat_desc.type = POWER_SUPPLY_TYPE_BATTERY;
+		mci->bat_desc.properties = mt6360_bat_props;
+		mci->bat_desc.num_properties = ARRAY_SIZE(mt6360_bat_props);
+		mci->bat_desc.get_property = mt6360_bat_get_property;
+		bat_cfg.drv_data = mci;
+		mci->bat_psy = devm_power_supply_register(dev, &mci->bat_desc, &bat_cfg);
+		if (IS_ERR(mci->bat_psy))
+			return dev_err_probe(dev, PTR_ERR(mci->bat_psy),
+					     "Failed to register battery\n");
+	}
+
+	schedule_delayed_work(&mci->bat_work, 0);
+	return 0;
+}
+
 static int mt6360_charger_get_property(struct power_supply *psy,
 				       enum power_supply_property psp,
 				       union power_supply_propval *val)
@@ -645,6 +969,7 @@ static irqreturn_t mt6360_pmu_attach_i_handler(int irq, void *data)
 	}
 
 	dev_dbg(mci->dev, "Received attach interrupt, chg_type = %d\n", mci->psy_usb_type);
+	mt6360_chg_apply_limits(mci);
 	if (last_usb_type != mci->psy_usb_type)
 		power_supply_changed(mci->psy);
 out:
@@ -669,6 +994,7 @@ static void mt6360_handle_chrdet_ext_evt(struct mt6360_chg_info *mci)
 	dev_dbg(mci->dev, "Received vbus interrupt, pwr_rdy = %d\n", pwr_rdy);
 	if (!pwr_rdy) {
 		mci->psy_usb_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+		mt6360_chg_apply_limits(mci);
 		power_supply_changed(mci->psy);
 
 	}
@@ -818,6 +1144,10 @@ static int mt6360_charger_probe(struct platform_device *pdev)
 				     "Failed to register power supply dev\n");
 
 
+	ret = mt6360_bat_init(mci);
+	if (ret)
+		return ret;
+
 	ret = mt6360_chg_irq_register(pdev);
 	if (ret)
 		return dev_err_probe(&pdev->dev, ret, "Failed to register irqs\n");
