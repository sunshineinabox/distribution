From: sunshineinabox <aqemail@gmail.com>
Date: Sun, 1 Nov 2026 11:00:00 +0000
Subject: [PATCH] soc: mediatek: mtk-svs: add MT6785 GPU banks

Add the MT6785 2-line GPU banks with the vendor EEM values. opp[0] takes
the fused GPU voltage bin, and init01 waits for a devfreq-driven buck to
settle at vboot.
---
diff --git a/drivers/soc/mediatek/mtk-svs.c b/drivers/soc/mediatek/mtk-svs.c
--- a/drivers/soc/mediatek/mtk-svs.c
+++ b/drivers/soc/mediatek/mtk-svs.c
@@ -16,6 +16,7 @@
 #include <linux/device.h>
 #include <linux/init.h>
 #include <linux/interrupt.h>
+#include <linux/iopoll.h>
 #include <linux/kernel.h>
 #include <linux/kthread.h>
 #include <linux/module.h>
@@ -502,6 +503,7 @@
  * @dcmdet: svs efuse data
  * @turn_pt: 2-line turn point tells which opp_volt calculated by high/low bank
  * @vbin_turn_pt: voltage bin turn point helps know which svsb_volt should be overridden
+ * @vbin_volt: fused voltage bin svsb_volt for opp[0], 0 uses the default opp voltage
  *
  * Svs bank will generate suitable voltages by below general math equation
  * and provide these voltages to opp voltage table.
@@ -530,6 +532,7 @@
 	u32 freq_base;
 	u32 turn_pt;
 	u32 vbin_turn_pt;
+	u8 vbin_volt;
 	u32 core_sel;
 	u32 temp;
 	u16 age_voffset_in;
@@ -1032,6 +1035,8 @@
 		svsb->volt[0] = svs_opp_volt_to_bank_volt(svsb->opp_dvolt[0],
 							  bdata->volt_step,
 							  bdata->volt_base);
+		if (svsb->vbin_volt)
+			svsb->volt[0] = min_t(u32, svsb->vbin_volt, svsb->volt[0]);
 
 		/* Find voltage bin turn point */
 		for (i = 0; i < bdata->opp_count; i++) {
@@ -1548,8 +1553,11 @@
 						      bdata->volt_step,
 						      bdata->volt_base);
 
-		buck_volt = regulator_get_voltage(svsb->buck);
-		if (buck_volt != opp_vboot) {
+		/* Devfreq-driven banks only reach vboot on their next poll */
+		r = read_poll_timeout(regulator_get_voltage, buck_volt,
+				      buck_volt == opp_vboot, 1000, 500000, false,
+				      svsb->buck);
+		if (r) {
 			dev_err(svsb->dev,
 				"buck voltage: %uuV, expected vboot: %uuV\n",
 				buck_volt, opp_vboot);
@@ -1987,8 +1995,10 @@
 static bool svs_mt6785_efuse_parsing(struct svs_platform *svsp,
 				     const struct svs_platform_data *pdata)
 {
-	struct svs_fusemap tfm = { 0, 0 };
-	u32 golden_temp, ft_pgm;
+	/* GPU opp[0] bin volts: 875, 875, 837.5, 800 mV */
+	static const u8 gpu_vbin_volt[] = { 0x4c, 0x4c, 0x46, 0x40 };
+	struct svs_fusemap tfm = { 0, 0 }, vbfm = { 14, 30 };
+	u32 golden_temp, ft_pgm, gpu_vbin;
 	int i;
 
 	if (!svs_is_available(svsp))
@@ -2000,6 +2010,7 @@
 		golden_temp = 50;
 
 	ft_pgm = svs_get_fuse_val(svsp->efuse, &pdata->glb_fuse_map[GLB_FT_PGM], 4);
+	gpu_vbin = svs_get_fuse_val(svsp->efuse, &vbfm, 2);
 
 	for (i = 0; i < svsp->bank_max; i++) {
 		struct svs_bank *svsb = &svsp->banks[i];
@@ -2007,6 +2018,9 @@
 
 		if (ft_pgm == 0)
 			svsb->volt_flags |= SVSB_INIT01_VOLT_IGNORE;
+
+		if (svsb->pdata.sw_id == SVSB_SWID_GPU)
+			svsb->vbin_volt = gpu_vbin_volt[gpu_vbin];
 
 		svsb->mtdes = svs_get_fuse_val(svsp->efuse, &dfmap[BDEV_MTDES], 8);
 		svsb->bdes = svs_get_fuse_val(svsp->efuse, &dfmap[BDEV_BDES], 8);
@@ -2959,6 +2973,69 @@
 		.vmax		= 0x73,
 		.vmin		= 0x20,
 	},
+	{
+		.pdata = (const struct svs_bank_pdata) {
+			.sw_id			= SVSB_SWID_GPU,
+			.type			= SVSB_TYPE_LOW,
+			.set_freq_pct		= svs_set_bank_freq_pct_v3,
+			.get_volts		= svs_get_bank_volts_v3,
+			.buck_name		= "mali",
+			.tzone_name		= "gpu0",
+			.opp_count		= MAX_OPP_ENTRIES,
+			.turn_freq_base		= 620000000,
+			.vboot			= 0x40,
+			.volt_step		= 6250,
+			.volt_base		= 400000,
+			.age_config		= 0x555555,
+			.dc_config		= 0x555555,
+			.vco			= 0x1c,
+			.chk_shift		= 0x87,
+			.int_st			= BIT(3),
+			.ctl0			= 0x00100003,
+			.tzone_htemp		= 85000,
+			.tzone_ltemp		= 25000,
+			.tzone_ltemp_voffset	= 7,
+			.dev_fuse_map		= (const struct svs_fusemap[BDEV_MAX]) {
+				{ 6, 0 }, { 6, 8 }, { 5, 0 }, { 6, 16 }, { 6, 24 }
+			}
+		},
+		.volt_flags	= SVSB_INIT01_PD_REQ | SVSB_INIT01_VOLT_INC_ONLY |
+				  SVSB_REMOVE_DVTFIXED_VOLT | SVSB_MON_VOLT_IGNORE,
+		.mode_support	= SVSB_MODE_INIT01 | SVSB_MODE_INIT02 | SVSB_MODE_MON,
+		.freq_base	= 620000000,
+		.core_sel	= 0x8fff0103,
+		.dvt_fixed	= 0x4,
+		.vmax		= 0x73,
+		.vmin		= 0x22,
+	},
+	{
+		.pdata = (const struct svs_bank_pdata) {
+			.sw_id			= SVSB_SWID_GPU,
+			.type			= SVSB_TYPE_HIGH,
+			.set_freq_pct		= svs_set_bank_freq_pct_v3,
+			.get_volts		= svs_get_bank_volts_v3,
+			.opp_count		= MAX_OPP_ENTRIES,
+			.turn_freq_base		= 620000000,
+			.volt_step		= 6250,
+			.volt_base		= 400000,
+			.age_config		= 0x555555,
+			.dc_config		= 0x555555,
+			.vco			= 0x1c,
+			.chk_shift		= 0x87,
+			.int_st			= BIT(4),
+			.ctl0			= 0x00100003,
+			.dev_fuse_map		= (const struct svs_fusemap[BDEV_MAX]) {
+				{ 24, 0 }, { 24, 8 }, { 23, 0 }, { 24, 16 }, { 24, 24 }
+			}
+		},
+		.volt_flags	= SVSB_REMOVE_DVTFIXED_VOLT,
+		.mode_support	= SVSB_MODE_INIT02,
+		.freq_base	= 806000000,
+		.core_sel	= 0x0fff0104,
+		.dvt_fixed	= 0x4,
+		.vmax		= 0x73,
+		.vmin		= 0x22,
+	},
 };
 
 static const struct svs_platform_data svs_mt8195_platform_data = {
