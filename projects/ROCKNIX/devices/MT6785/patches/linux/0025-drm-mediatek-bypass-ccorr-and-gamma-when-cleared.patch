From: sunshineinabox <aqemail@gmail.com>
Date: Sat, 7 Nov 2026 21:40:00 +0000
Subject: [PATCH] drm/mediatek: bypass CCORR and gamma when CTM and GAMMA_LUT
 are cleared

Setting CTM or GAMMA_LUT to 0 returned early and left the last matrix or
LUT applied. Bypass the blocks instead, as Nícolas F. R. A. Prado's CRTC
color pipeline series ("drm/mediatek: ccorr: Support CRTC color pipeline
API", "drm/mediatek: gamma: Support CRTC color pipeline API") does for its
colorops.
---
--- a/drivers/gpu/drm/mediatek/mtk_disp_ccorr.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_ccorr.c
@@ -84,18 +84,19 @@
 {
 	struct mtk_disp_ccorr *ccorr = dev_get_drvdata(dev);
 	struct drm_property_blob *blob = state->ctm;
-	struct drm_color_ctm *ctm;
+	static const u64 identity[9] = {
+		1ULL << 32, 0, 0,
+		0, 1ULL << 32, 0,
+		0, 0, 1ULL << 32,
+	};
 	const u64 *input;
 	uint16_t coeffs[9] = { 0 };
 	int i;
 	struct cmdq_pkt *cmdq_pkt = NULL;
 	u32 matrix_bits = ccorr->data->matrix_bits;
 
-	if (!blob)
-		return;
-
-	ctm = (struct drm_color_ctm *)blob->data;
-	input = ctm->matrix;
+	/* A cleared CTM bypasses the block and leaves identity for later configs */
+	input = blob ? ((struct drm_color_ctm *)blob->data)->matrix : identity;
 
 	for (i = 0; i < ARRAY_SIZE(coeffs); i++)
 		coeffs[i] = drm_color_ctm_s31_32_to_qm_n(input[i], 2, matrix_bits);
@@ -110,6 +111,8 @@
 		      &ccorr->cmdq_reg, ccorr->regs, DISP_CCORR_COEF_3);
 	mtk_ddp_write(cmdq_pkt, coeffs[8] << 16,
 		      &ccorr->cmdq_reg, ccorr->regs, DISP_CCORR_COEF_4);
+	mtk_ddp_write_mask(cmdq_pkt, blob ? 0 : CCORR_RELAY_MODE, &ccorr->cmdq_reg,
+			   ccorr->regs, DISP_CCORR_CFG, CCORR_RELAY_MODE);
 }
 
 static int mtk_disp_ccorr_bind(struct device *dev, struct device *master,
--- a/drivers/gpu/drm/mediatek/mtk_disp_gamma.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_gamma.c
@@ -124,9 +124,14 @@
 	struct drm_color_lut *lut;
 	unsigned int i;
 
-	/* If there's no gamma lut there's nothing to do here. */
-	if (!state->gamma_lut)
+	/* A cleared LUT bypasses the block */
+	if (!state->gamma_lut) {
+		cfg_val = readl(gamma->regs + DISP_GAMMA_CFG);
+		cfg_val &= ~GAMMA_LUT_EN;
+		cfg_val |= GAMMA_RELAY_MODE;
+		writel(cfg_val, gamma->regs + DISP_GAMMA_CFG);
 		return;
+	}
 
 	num_lut_banks = gamma->data->lut_size / gamma->data->lut_bank_size;
 	lut = (struct drm_color_lut *)state->gamma_lut->data;
