--- a/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
+++ b/drivers/gpu/drm/mediatek/mtk_disp_ovl.c
@@ -327,6 +327,15 @@ static void mtk_ovl_set_bit_depth(struct device *dev, 
 			   OVL_CON_CLRFMT_BIT_DEPTH_MASK(idx));
 }
 
+void mtk_ovl_set_roi(struct device *dev, unsigned int w, unsigned int h,
