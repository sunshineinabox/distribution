-	mtk_ovl_layer_on(dev, idx, cmdq_pkt);
+	mtk_ovl_hw_layer_on(ovl, idx, cmdq_pkt);
 }
 
+void mtk_ovl_layer_config(struct device *dev, unsigned int idx,
+			  struct mtk_plane_state *state,
+			  struct cmdq_pkt *cmdq_pkt)
+{
+	struct mtk_disp_ovl *ovl = dev_get_drvdata(dev);
+	struct mtk_plane_pending_state *pending = &state->pending;
+	unsigned int max = ovl->data->afbc_max_width;
+	unsigned int hw = mtk_ovl_hw_layer(ovl, idx);
+	bool split = pending->enable && pending->modifier != DRM_FORMAT_MOD_LINEAR &&
+		     max && pending->width > max;
+	unsigned int left;
+
+	/* layer 1 stays off unless it fetches the right half of layer 0 */
+	if (ovl->data->afbc_split && !hw && !split)
+		mtk_ovl_hw_layer_off(ovl, 1, cmdq_pkt);
+
+	if (!pending->enable) {
+		mtk_ovl_hw_layer_off(ovl, hw, cmdq_pkt);
+		return;
+	}
+
+	if (!split) {
+		mtk_ovl_hw_layer_config(dev, hw, state, pending->x, pending->src_x,
+					pending->width, cmdq_pkt);
+		return;
+	}
+
+	/* under a half turn the left half of the screen shows the right half of the source */
+	left = ALIGN(DIV_ROUND_UP(pending->width, 2), AFBC_DATA_BLOCK_WIDTH);
+	if (pending->rotation & DRM_MODE_ROTATE_180) {
+		mtk_ovl_hw_layer_config(dev, 0, state, pending->x,
+					pending->src_x + pending->width - left, left, cmdq_pkt);
+		mtk_ovl_hw_layer_config(dev, 1, state, pending->x + left, pending->src_x,
+					pending->width - left, cmdq_pkt);
+	} else {
+		mtk_ovl_hw_layer_config(dev, 0, state, pending->x, pending->src_x, left,
+					cmdq_pkt);
+		mtk_ovl_hw_layer_config(dev, 1, state, pending->x + left,
+					pending->src_x + left, pending->width - left, cmdq_pkt);
+	}
+}
