From: sunshineinabox <aqemail@gmail.com>
Date: Thu, 30 Oct 2026 13:00:00 +0000
Subject: [PATCH] drm/panfrost: let MT6785 drop clocks and supplies at idle

Add GPU_PM_RT_OFF, which unprepares the clocks and drops the OPP supplies
at runtime suspend so the MFG domains and GPU bucks can power down at idle.
Use it on MT6785 in place of GPU_PM_CLK_DIS and GPU_PM_VREG_OFF.
---
diff --git a/drivers/gpu/drm/panfrost/panfrost_device.c b/drivers/gpu/drm/panfrost/panfrost_device.c
--- a/drivers/gpu/drm/panfrost/panfrost_device.c
+++ b/drivers/gpu/drm/panfrost/panfrost_device.c
@@ -420,6 +420,29 @@ static int panfrost_device_runtime_resume(struct device *dev)
 	struct panfrost_device *pfdev = dev_get_drvdata(dev);
 	int ret;
 
+	if (pfdev->comp->pm_features & BIT(GPU_PM_RT_OFF)) {
+		unsigned long freq = clk_get_rate(pfdev->clock);
+		struct dev_pm_opp *opp;
+
+		opp = dev_pm_opp_find_freq_ceil(dev, &freq);
+		if (IS_ERR(opp))
+			return PTR_ERR(opp);
+		ret = dev_pm_opp_set_opp(dev, opp);
+		dev_pm_opp_put(opp);
+		if (ret)
+			return ret;
+
+		ret = clk_prepare_enable(pfdev->clock);
+		if (ret)
+			goto err_rt_off_opp;
+
+		if (pfdev->bus_clock) {
+			ret = clk_prepare_enable(pfdev->bus_clock);
+			if (ret)
+				goto err_rt_off_clk;
+		}
+	}
+
 	if (pfdev->comp->pm_features & BIT(GPU_PM_RT)) {
 		ret = reset_control_deassert(pfdev->rstc);
 		if (ret)
@@ -448,6 +471,12 @@ static int panfrost_device_runtime_resume(struct device *dev)
 	if (pfdev->comp->pm_features & BIT(GPU_PM_RT))
 		reset_control_assert(pfdev->rstc);
 	return ret;
+
+err_rt_off_clk:
+	clk_disable_unprepare(pfdev->clock);
+err_rt_off_opp:
+	dev_pm_opp_set_opp(dev, NULL);
+	return ret;
 }
 
 static int panfrost_device_runtime_suspend(struct device *dev)
@@ -471,6 +500,14 @@ static int panfrost_device_runtime_suspend(struct device *dev)
 		reset_control_assert(pfdev->rstc);
 	}
 
+	if (pfdev->comp->pm_features & BIT(GPU_PM_RT_OFF)) {
+		if (pfdev->bus_clock)
+			clk_disable_unprepare(pfdev->bus_clock);
+
+		clk_disable_unprepare(pfdev->clock);
+		dev_pm_opp_set_opp(dev, NULL);
+	}
+
 	return 0;
 }
 
diff --git a/drivers/gpu/drm/panfrost/panfrost_device.h b/drivers/gpu/drm/panfrost/panfrost_device.h
--- a/drivers/gpu/drm/panfrost/panfrost_device.h
+++ b/drivers/gpu/drm/panfrost/panfrost_device.h
@@ -43,11 +43,14 @@ enum panfrost_drv_comp_bits {
  * @GPU_PM_VREG_OFF: Allow turning off regulators during system suspend
  * @GPU_PM_RT: Allow disabling clocks and asserting the reset control during
  *  system runtime suspend
+ * @GPU_PM_RT_OFF: Unprepare clocks and drop the OPP supplies during runtime
+ *  suspend
  */
 enum panfrost_gpu_pm {
 	GPU_PM_CLK_DIS,
 	GPU_PM_VREG_OFF,
-	GPU_PM_RT
+	GPU_PM_RT,
+	GPU_PM_RT_OFF
 };
 
 /**
diff --git a/drivers/gpu/drm/panfrost/panfrost_drv.c b/drivers/gpu/drm/panfrost/panfrost_drv.c
--- a/drivers/gpu/drm/panfrost/panfrost_drv.c
+++ b/drivers/gpu/drm/panfrost/panfrost_drv.c
@@ -1099,7 +1099,7 @@ static const struct panfrost_compatible mediatek_mt6785_data = {
 	.supply_names = default_supplies,
 	.num_pm_domains = 4,
 	.pm_domain_names = mediatek_pm_domains,
-	.pm_features = BIT(GPU_PM_CLK_DIS) | BIT(GPU_PM_VREG_OFF),
+	.pm_features = BIT(GPU_PM_RT_OFF),
 };
 
 /*
