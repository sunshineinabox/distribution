From: sunshineinabox <aqemail@gmail.com>
Date: Thu, 30 Oct 2026 18:15:00 +0000
Subject: [PATCH] iio: adc: ti-ads1015: add the SGM58031

The SGM58031 is register compatible with the ADS1115 but lags behind mux
changes in continuous mode. Run it in single-shot mode and poll OS on
each read, as the vendor driver does.
---
diff --git a/drivers/iio/adc/ti-ads1015.c b/drivers/iio/adc/ti-ads1015.c
index c7ffe4744..5d2f5202d 100644
--- a/drivers/iio/adc/ti-ads1015.c
+++ b/drivers/iio/adc/ti-ads1015.c
@@ -56,6 +56,7 @@
 #define ADS1015_CFG_MOD_MASK	BIT(8)
 #define ADS1015_CFG_PGA_MASK	GENMASK(11, 9)
 #define ADS1015_CFG_MUX_MASK	GENMASK(14, 12)
+#define ADS1015_CFG_OS		BIT(15)
 
 /* Comparator queue and disable field */
 #define ADS1015_CFG_COMP_DISABLE	3
@@ -86,6 +87,7 @@ struct ads1015_chip_data {
 	const int			*scale;
 	const int			scale_len;
 	bool				has_comparator;
+	bool				single_shot;
 };
 
 enum ads1015_channels {
@@ -420,6 +422,22 @@ int ads1015_get_adc_result(struct ads1015_data *data, int chan, int *val)
 	}
 
 	cfg = (old & ~mask) | (cfg & mask);
+
+	/* the SGM58031 lags behind mux changes in continuous mode */
+	if (data->chip->single_shot) {
+		ret = regmap_write(data->regmap, ADS1015_CFG_REG,
+				   cfg | ADS1015_CFG_OS | ADS1015_CFG_MOD_MASK);
+		if (ret)
+			return ret;
+		usleep_range(500, 1000);
+		ret = regmap_read_poll_timeout(data->regmap, ADS1015_CFG_REG,
+					       old, old & ADS1015_CFG_OS,
+					       250, 20000);
+		if (ret)
+			return ret;
+		return regmap_read(data->regmap, ADS1015_CONV_REG, val);
+	}
+
 	if (old != cfg) {
 		ret = regmap_write(data->regmap, ADS1015_CFG_REG, cfg);
 		if (ret)
@@ -925,6 +943,9 @@ static void ads1015_get_channels_config(struct i2c_client *client)
 
 static int ads1015_set_conv_mode(struct ads1015_data *data, int mode)
 {
+	if (data->chip->single_shot)
+		mode = ADS1015_SINGLESHOT;
+
 	return regmap_update_bits(data->regmap, ADS1015_CFG_REG,
 				  ADS1015_CFG_MOD_MASK,
 				  mode << ADS1015_CFG_MOD_SHIFT);
@@ -1116,6 +1137,18 @@ static const struct ads1015_chip_data ads1115_data = {
 	.has_comparator	= true,
 };
 
+static const struct ads1015_chip_data sgm58031_data = {
+	.channels	= ads1115_channels,
+	.num_channels	= ARRAY_SIZE(ads1115_channels),
+	.info		= &ads1015_info,
+	.data_rate	= ads1115_data_rate,
+	.data_rate_len	= ARRAY_SIZE(ads1115_data_rate),
+	.scale		= ads1115_scale,
+	.scale_len	= ARRAY_SIZE(ads1115_scale),
+	.has_comparator	= true,
+	.single_shot	= true,
+};
+
 static const struct ads1015_chip_data tla2024_data = {
 	.channels	= tla2024_channels,
 	.num_channels	= ARRAY_SIZE(tla2024_channels),
@@ -1130,6 +1163,7 @@ static const struct ads1015_chip_data tla2024_data = {
 static const struct i2c_device_id ads1015_id[] = {
 	{ "ads1015", (kernel_ulong_t)&ads1015_data },
 	{ "ads1115", (kernel_ulong_t)&ads1115_data },
+	{ "sgm58031", (kernel_ulong_t)&sgm58031_data },
 	{ "tla2024", (kernel_ulong_t)&tla2024_data },
 	{ }
 };
@@ -1138,6 +1172,7 @@ MODULE_DEVICE_TABLE(i2c, ads1015_id);
 static const struct of_device_id ads1015_of_match[] = {
 	{ .compatible = "ti,ads1015", .data = &ads1015_data },
 	{ .compatible = "ti,ads1115", .data = &ads1115_data },
+	{ .compatible = "sgmicro,sgm58031", .data = &sgm58031_data },
 	{ .compatible = "ti,tla2024", .data = &tla2024_data },
 	{ }
 };
