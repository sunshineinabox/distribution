From: sunshineinabox <aqemail@gmail.com>
Date: Thu, 30 Oct 2026 21:10:00 +0000
Subject: [PATCH] iio: accel: mc3230: add MC3416 support

The MC3416 shares the MC3230 mode and ID registers but has 16-bit
outputs. Set it up like the vendor driver for +-8g at 2048 Hz.
---
diff --git a/drivers/iio/accel/mc3230.c b/drivers/iio/accel/mc3230.c
index 3e494f9dd..50bb992c5 100644
--- a/drivers/iio/accel/mc3230.c
+++ b/drivers/iio/accel/mc3230.c
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 /*
- * mCube MC3230 3-Axis Accelerometer
+ * mCube MC3230/MC3416 3-Axis Accelerometer
  *
  * Copyright (c) 2016 Hans de Goede <hdegoede@redhat.com>
  *
@@ -24,6 +24,16 @@
 #define MC3230_REG_CHIP_ID		0x18
 #define MC3230_REG_PRODUCT_CODE		0x3b
 
+/* MC3416: 16-bit outputs, set up in standby */
+#define MC3416_REG_XOUT_L		0x0d
+#define MC3416_REG_YOUT_L		0x0f
+#define MC3416_REG_ZOUT_L		0x11
+#define MC3416_REG_SR			0x08
+#define MC3416_SR_MASK			GENMASK(2, 0)
+#define MC3416_SR_2048HZ		0x05
+#define MC3416_REG_RANGE		0x20
+#define MC3416_RANGE_8G_LPF		0x29	/* 16-bit, +-8g, LPF 128 Hz */
+
 /*
  * The accelerometer has one measurement range:
  *
@@ -36,6 +46,7 @@ struct mc3230_chip_info {
 	const u8 chip_id;
 	const u8 product_code;
 	const int scale;
+	const bool wide;
 };
 
 static const struct mc3230_chip_info mc3230_chip_info = {
@@ -54,6 +65,15 @@ static const struct mc3230_chip_info mc3510c_chip_info = {
 	.scale = 625000000,
 };
 
+static const struct mc3230_chip_info mc3416_chip_info = {
+	.name = "mc3416",
+	.chip_id = 0xa0,
+	.product_code = 0x20,
+	/* 9.80665 / 4096 (16-bit, +-8g) */
+	.scale = 2394202,
+	.wide = true,
+};
+
 #define MC3230_CHANNEL(reg, axis) {	\
 	.type = IIO_ACCEL,	\
 	.address = reg,	\
@@ -90,6 +110,12 @@ static const struct iio_chan_spec mc3230_channels[] = {
 	MC3230_CHANNEL(MC3230_REG_ZOUT, Z),
 };
 
+static const struct iio_chan_spec mc3416_channels[] = {
+	MC3230_CHANNEL(MC3416_REG_XOUT_L, X),
+	MC3230_CHANNEL(MC3416_REG_YOUT_L, Y),
+	MC3230_CHANNEL(MC3416_REG_ZOUT_L, Z),
+};
+
 static int mc3230_set_opcon(struct mc3230_data *data, int opcon)
 {
 	int ret;
@@ -122,10 +148,13 @@ static int mc3230_read_raw(struct iio_dev *indio_dev,
 
 	switch (mask) {
 	case IIO_CHAN_INFO_RAW:
-		ret = i2c_smbus_read_byte_data(data->client, chan->address);
+		if (data->chip_info->wide)
+			ret = i2c_smbus_read_word_data(data->client, chan->address);
+		else
+			ret = i2c_smbus_read_byte_data(data->client, chan->address);
 		if (ret < 0)
 			return ret;
-		*val = sign_extend32(ret, 7);
+		*val = sign_extend32(ret, data->chip_info->wide ? 15 : 7);
 		return IIO_VAL_INT;
 	case IIO_CHAN_INFO_SCALE:
 		*val = 0;
@@ -136,6 +165,29 @@ static int mc3230_read_raw(struct iio_dev *indio_dev,
 	}
 }
 
+/* range, resolution and rate only change in standby */
+static int mc3416_init(struct mc3230_data *data)
+{
+	struct i2c_client *client = data->client;
+	int ret;
+
+	ret = mc3230_set_opcon(data, MC3230_MODE_OPCON_STANDBY);
+	if (ret < 0)
+		return ret;
+
+	ret = i2c_smbus_write_byte_data(client, MC3416_REG_RANGE,
+					MC3416_RANGE_8G_LPF);
+	if (ret < 0)
+		return ret;
+
+	ret = i2c_smbus_read_byte_data(client, MC3416_REG_SR);
+	if (ret < 0)
+		return ret;
+
+	return i2c_smbus_write_byte_data(client, MC3416_REG_SR,
+					 (ret & ~MC3416_SR_MASK) | MC3416_SR_2048HZ);
+}
+
 static const struct iio_info mc3230_info = {
 	.read_raw	= mc3230_read_raw,
 };
@@ -180,8 +232,19 @@ static int mc3230_probe(struct i2c_client *client)
 	indio_dev->info = &mc3230_info;
 	indio_dev->name = chip_info->name;
 	indio_dev->modes = INDIO_DIRECT_MODE;
-	indio_dev->channels = mc3230_channels;
-	indio_dev->num_channels = ARRAY_SIZE(mc3230_channels);
+	if (chip_info->wide) {
+		indio_dev->channels = mc3416_channels;
+		indio_dev->num_channels = ARRAY_SIZE(mc3416_channels);
+
+		ret = mc3416_init(data);
+		if (ret < 0) {
+			dev_err(&client->dev, "failed to set up: %d\n", ret);
+			return ret;
+		}
+	} else {
+		indio_dev->channels = mc3230_channels;
+		indio_dev->num_channels = ARRAY_SIZE(mc3230_channels);
+	}
 
 	ret = mc3230_set_opcon(data, MC3230_MODE_OPCON_WAKE);
 	if (ret < 0)
@@ -232,6 +295,7 @@ static DEFINE_SIMPLE_DEV_PM_OPS(mc3230_pm_ops, mc3230_suspend, mc3230_resume);
 static const struct i2c_device_id mc3230_i2c_id[] = {
 	{ "mc3230", (kernel_ulong_t)&mc3230_chip_info },
 	{ "mc3510c", (kernel_ulong_t)&mc3510c_chip_info },
+	{ "mc3416", (kernel_ulong_t)&mc3416_chip_info },
 	{ }
 };
 MODULE_DEVICE_TABLE(i2c, mc3230_i2c_id);
@@ -239,6 +303,7 @@ MODULE_DEVICE_TABLE(i2c, mc3230_i2c_id);
 static const struct of_device_id mc3230_of_match[] = {
 	{ .compatible = "mcube,mc3230", &mc3230_chip_info },
 	{ .compatible = "mcube,mc3510c", &mc3510c_chip_info },
+	{ .compatible = "mcube,mc3416", &mc3416_chip_info },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, mc3230_of_match);
@@ -257,5 +322,5 @@ static struct i2c_driver mc3230_driver = {
 module_i2c_driver(mc3230_driver);
 
 MODULE_AUTHOR("Hans de Goede <hdegoede@redhat.com>");
-MODULE_DESCRIPTION("mCube MC3230 3-Axis Accelerometer driver");
+MODULE_DESCRIPTION("mCube MC3230/MC3416 3-Axis Accelerometer driver");
 MODULE_LICENSE("GPL v2");
