From: sunshineinabox <aqemail@gmail.com>
Date: Thu, 5 Nov 2026 21:57:56 -0800
Subject: [PATCH] mali_kbase: devicetree: count clock and regulator references

On MT6785 the power domain keeps vgpu on and the mfg_bg3d gate does not
read back while its domain is off, so deciding by hardware state
unbalances the clock and regulator references. Count the references the
platform holds instead, and leave a runtime-suspended GPU off on system
resume.
---
 .../drivers/gpu/arm/midgard/mali_kbase_defs.h |  2 +
 .../devicetree/mali_kbase_runtime_pm.c        | 71 ++++++++++++++-----
 2 files changed, 57 insertions(+), 16 deletions(-)

diff --git a/product/kernel/drivers/gpu/arm/midgard/mali_kbase_defs.h b/product/kernel/drivers/gpu/arm/midgard/mali_kbase_defs.h
index 8462e48..cfee8e1 100644
--- a/product/kernel/drivers/gpu/arm/midgard/mali_kbase_defs.h
+++ b/product/kernel/drivers/gpu/arm/midgard/mali_kbase_defs.h
@@ -1200,6 +1200,8 @@ struct kbase_device {
 	wait_queue_head_t cache_clean_wait;
 
 	void *platform_context;
+	/* Platform runtime PM holds its clock and regulator references */
+	bool power_control_on;
 
 	struct list_head kctx_list;
 	struct mutex kctx_list_lock;
diff --git a/product/kernel/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_runtime_pm.c b/product/kernel/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_runtime_pm.c
index 9e3f789..1bb257a 100644
--- a/product/kernel/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_runtime_pm.c
+++ b/product/kernel/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_runtime_pm.c
@@ -29,49 +29,71 @@
 
 #include "mali_kbase_config_platform.h"
 
-static void enable_gpu_power_control(struct kbase_device *kbdev)
+static void get_gpu_regulators(struct kbase_device *kbdev)
 {
+#if defined(CONFIG_REGULATOR)
 	unsigned int i;
 
-#if defined(CONFIG_REGULATOR)
 	for (i = 0; i < kbdev->nr_regulators; i++) {
 		if (WARN_ON(kbdev->regulators[i] == NULL))
 			;
-		else if (!regulator_is_enabled(kbdev->regulators[i]))
+		else
 			WARN_ON(regulator_enable(kbdev->regulators[i]));
 	}
 #endif
+}
+
+static void put_gpu_regulators(struct kbase_device *kbdev)
+{
+#if defined(CONFIG_REGULATOR)
+	unsigned int i;
+
+	for (i = 0; i < kbdev->nr_regulators; i++) {
+		if (WARN_ON(kbdev->regulators[i] == NULL))
+			;
+		else
+			WARN_ON(regulator_disable(kbdev->regulators[i]));
+	}
+#endif
+}
+
+/* Count references, since gates in a powered-off domain do not read back */
+static void enable_gpu_power_control(struct kbase_device *kbdev)
+{
+	unsigned int i;
+
+	if (kbdev->power_control_on)
+		return;
+
+	get_gpu_regulators(kbdev);
 
 	for (i = 0; i < kbdev->nr_clocks; i++) {
 		if (WARN_ON(kbdev->clocks[i] == NULL))
 			;
-		else if (!__clk_is_enabled(kbdev->clocks[i]))
+		else
 			WARN_ON(clk_prepare_enable(kbdev->clocks[i]));
 	}
+
+	kbdev->power_control_on = true;
 }
 
 static void disable_gpu_power_control(struct kbase_device *kbdev)
 {
 	unsigned int i;
 
+	if (!kbdev->power_control_on)
+		return;
+
 	for (i = 0; i < kbdev->nr_clocks; i++) {
 		if (WARN_ON(kbdev->clocks[i] == NULL))
 			;
-		else if (__clk_is_enabled(kbdev->clocks[i])) {
+		else
 			clk_disable_unprepare(kbdev->clocks[i]);
-			WARN_ON(__clk_is_enabled(kbdev->clocks[i]));
-		}
 	}
 
-#if defined(CONFIG_REGULATOR)
-	for (i = 0; i < kbdev->nr_regulators; i++) {
-		if (WARN_ON(kbdev->regulators[i] == NULL))
-			;
-		else if (regulator_is_enabled(kbdev->regulators[i]))
-			WARN_ON(regulator_disable(kbdev->regulators[i]));
-	}
-#endif
+	put_gpu_regulators(kbdev);
 
+	kbdev->power_control_on = false;
 }
 
 static int pm_callback_power_on(struct kbase_device *kbdev)
@@ -209,6 +231,10 @@ static int kbase_device_runtime_init(struct kbase_device *kbdev)
 	pm_runtime_set_autosuspend_delay(kbdev->dev, AUTO_SUSPEND_DELAY);
 	pm_runtime_use_autosuspend(kbdev->dev);
 
+	/* The device starts active: probe enabled the clocks, add the regulators */
+	get_gpu_regulators(kbdev);
+	kbdev->power_control_on = true;
+
 	pm_runtime_set_active(kbdev->dev);
 	pm_runtime_enable(kbdev->dev);
 
@@ -233,6 +259,12 @@ static void kbase_device_runtime_disable(struct kbase_device *kbdev)
 			 __func__, atomic_read(&kbdev->dev->power.usage_count));
 
 	pm_runtime_disable(kbdev->dev);
+
+	/* power_control_term() drops probe's clock references */
+	if (kbdev->power_control_on) {
+		put_gpu_regulators(kbdev);
+		kbdev->power_control_on = false;
+	}
 }
 #endif /* KBASE_PM_RUNTIME */
 
@@ -257,7 +289,14 @@ static void pm_callback_runtime_off(struct kbase_device *kbdev)
 
 static void pm_callback_resume(struct kbase_device *kbdev)
 {
-	int ret = pm_callback_runtime_on(kbdev);
+	int ret;
+
+#ifdef KBASE_PM_RUNTIME
+	/* Its domain stays off; the next runtime resume powers it */
+	if (pm_runtime_status_suspended(kbdev->dev))
+		return;
+#endif
+	ret = pm_callback_runtime_on(kbdev);
 
 	WARN_ON(ret);
 }
-- 
2.55.0

