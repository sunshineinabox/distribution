From: sunshineinabox <aqemail@gmail.com>
Date: Mon, 2 Nov 2026 02:00:00 +0000
Subject: [PATCH] mali_kbase: devfreq: vote the OPP's interconnect bandwidth

kbase sets clocks and regulators itself, so the opp-peak-kBps of the GPU
OPPs is never voted. Vote each OPP's peak bandwidth on the device's
interconnect path, as the OPP core does for panfrost.
---
--- a/product/kernel/drivers/gpu/arm/midgard/backend/gpu/mali_kbase_devfreq.c
+++ b/product/kernel/drivers/gpu/arm/midgard/backend/gpu/mali_kbase_devfreq.c
@@ -26,6 +26,7 @@
 #include <linux/of.h>
 #include <linux/clk.h>
 #include <linux/devfreq.h>
+#include <linux/interconnect.h>
 #if IS_ENABLED(CONFIG_DEVFREQ_THERMAL)
 #include <linux/devfreq_cooling.h>
 #endif
@@ -120,6 +121,7 @@ static int kbase_devfreq_target(struct device *dev, unsigned long *target_freq,
 	unsigned int i;
 	int err;
 	u64 core_mask;
+	unsigned long peak_bw;
 
 	nominal_freq = *target_freq;
 
@@ -134,6 +136,8 @@ static int kbase_devfreq_target(struct device *dev, unsigned long *target_freq,
 		dev_err(dev, "Failed to get opp (%d)\n", PTR_ERR_OR_ZERO(opp));
 		return IS_ERR(opp) ? PTR_ERR(opp) : -ENODEV;
 	}
+	/* the OPP's opp-peak-kBps, voted like the OPP core does for panfrost */
+	peak_bw = dev_pm_opp_get_bw(opp, true, 0);
 #if KERNEL_VERSION(4, 11, 0) <= LINUX_VERSION_CODE
 	dev_pm_opp_put(opp);
 #endif
@@ -211,6 +215,8 @@ static int kbase_devfreq_target(struct device *dev, unsigned long *target_freq,
 	}
 #endif
 
+	icc_set_bw(kbdev->devfreq_icc, 0, peak_bw);
+
 	*target_freq = nominal_freq;
 	kbdev->current_nominal_freq = nominal_freq;
 	kbdev->current_core_mask = core_mask;
@@ -652,6 +658,13 @@ int kbase_devfreq_init(struct kbase_device *kbdev)
 	if (err)
 		goto init_core_mask_table_failed;
 
+	kbdev->devfreq_icc = devm_of_icc_get(kbdev->dev, NULL);
+	if (IS_ERR(kbdev->devfreq_icc)) {
+		dev_warn(kbdev->dev, "No interconnect path (%ld), DDR follows load only\n",
+			 PTR_ERR(kbdev->devfreq_icc));
+		kbdev->devfreq_icc = NULL;
+	}
+
 	kbdev->devfreq = devfreq_add_device(kbdev->dev, dp, "simple_ondemand", &kbase_ondemand_data);
 	if (IS_ERR(kbdev->devfreq)) {
 		err = PTR_ERR(kbdev->devfreq);
--- a/product/kernel/drivers/gpu/arm/midgard/mali_kbase_defs.h
+++ b/product/kernel/drivers/gpu/arm/midgard/mali_kbase_defs.h
@@ -1207,6 +1207,7 @@ struct kbase_device {
 #ifdef CONFIG_MALI_DEVFREQ
 	struct devfreq_dev_profile devfreq_profile;
 	struct devfreq *devfreq;
+	struct icc_path *devfreq_icc;
 	unsigned long current_freqs[BASE_MAX_NR_CLOCKS_REGULATORS];
 	unsigned long current_nominal_freq;
 	unsigned long current_voltages[BASE_MAX_NR_CLOCKS_REGULATORS];
