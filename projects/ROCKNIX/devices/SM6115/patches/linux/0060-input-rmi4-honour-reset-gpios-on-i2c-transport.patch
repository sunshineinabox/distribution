input: rmi4: honour reset-gpios on I2C transport

---
 drivers/input/rmi4/rmi_i2c.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

--- a/drivers/input/rmi4/rmi_i2c.c
+++ b/drivers/input/rmi4/rmi_i2c.c
@@ -7,6 +7,7 @@
 #include <linux/i2c.h>
 #include <linux/rmi.h>
 #include <linux/of.h>
+#include <linux/gpio/consumer.h>
 #include <linux/delay.h>
 #include <linux/regulator/consumer.h>
 #include "rmi_driver.h"
@@ -14,6 +15,9 @@
 #define BUFFER_SIZE_INCREMENT 32
 
+#define RMI_I2C_RESET_ACTIVE_MS	20
+#define RMI_I2C_RESET_DELAY_MS	200
+
 /**
  * struct rmi_i2c_xport - stores information for i2c communication
  *
  * @xport: The transport interface structure
@@ -27,6 +34,7 @@
  *
  * @supplies: Array of voltage regulators
  * @startup_delay: Milliseconds to pause after powering up the regulators
+ * @reset_gpio: Optional reset line, asserted while the supplies settle
  */
 struct rmi_i2c_xport {
 	struct rmi_transport_dev xport;
@@ -40,6 +48,7 @@ struct rmi_i2c_xport {
 
 	struct regulator_bulk_data supplies[2];
 	u32 startup_delay;
+	struct gpio_desc *reset_gpio;
 };
 
 #define RMI_PAGE_SELECT_REGISTER 0xff
@@ -244,10 +253,28 @@ static int rmi_i2c_probe(struct i2c_client *client)
 	if (error)
 		return error;
 
+	rmi_i2c->reset_gpio = devm_gpiod_get_optional(&client->dev, "reset",
+						      GPIOD_OUT_HIGH);
+	if (IS_ERR(rmi_i2c->reset_gpio))
+		return dev_err_probe(&client->dev, PTR_ERR(rmi_i2c->reset_gpio),
+				     "failed to get reset GPIO\n");
+
 	of_property_read_u32(client->dev.of_node, "syna,startup-delay-ms",
 			     &rmi_i2c->startup_delay);
 
 	msleep(rmi_i2c->startup_delay);
 
+	if (rmi_i2c->reset_gpio) {
+		u32 reset_delay = 0;
+
+		msleep(RMI_I2C_RESET_ACTIVE_MS);
+		gpiod_set_value_cansleep(rmi_i2c->reset_gpio, 0);
+
+		of_property_read_u32(client->dev.of_node,
+				     "syna,reset-delay-ms", &reset_delay);
+
+		msleep(reset_delay ?: RMI_I2C_RESET_DELAY_MS);
+	}
+
 	rmi_i2c->client = client;
 	mutex_init(&rmi_i2c->page_mutex);

